// ─── Platform administration, audit, privacy ────────────────────────────────

enum SupportCaseType {
  COMPLAINT
  DISPUTE
  SUPPORT
  REFUND_REQUEST
  PROVIDER_REPORT
}

enum SupportCasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REPORTER
  ESCALATED
  RESOLVED
  CLOSED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum ExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ConsentScope {
  PLATFORM_DATA_PROCESSING
  REPORT_SHARING
  RECORD_ACCESS_BY_PROVIDER
  COMMUNICATIONS
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  CONTAINED
  RESOLVED
  CLOSED
}

model SupportCase {
  id             String              @id @map("_id") @default(uuid(7))
  reference      String              @unique
  type           SupportCaseType
  category       String
  priority       SupportCasePriority @default(MEDIUM)
  status         SupportCaseStatus   @default(OPEN)
  subject        String
  description    String
  reporterUserId String?             @map("reporter_user_id")
  providerId     String?             @map("provider_id")
  transactionId  String?             @map("transaction_id")
  assignedToId   String?             @map("assigned_to_id")
  slaDueAt       DateTime?           @map("sla_due_at")
  resolution     String?
  resolvedAt     DateTime?           @map("resolved_at")
  createdById    String?             @map("created_by_id")
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  provider    Provider?           @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transaction ServiceTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events      SupportCaseEvent[]

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("support_cases")
}

model SupportCaseEvent {
  id         String   @id @map("_id") @default(uuid(7))
  caseId     String   @map("case_id")
  authorId   String?  @map("author_id")
  kind       String // COMMENT | STATUS_CHANGE | ASSIGNMENT | ESCALATION
  body       String?
  isInternal Boolean  @default(true) @map("is_internal")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caseId, createdAt])
  @@map("support_case_events")
}

/// Internal note on any entity (provider, user, transaction…).
model AdminNote {
  id          String   @id @map("_id") @default(uuid(7))
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  authorId    String   @map("author_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  @@map("admin_notes")
}

model NotificationTemplate {
  id        String              @id @map("_id") @default(uuid(7))
  key       String
  channel   NotificationChannel
  locale    String              @default("en")
  version   Int                 @default(1)
  subject   String?
  body      String
  isActive  Boolean             @default(true) @map("is_active")
  updatedById String?           @map("updated_by_id")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([key, channel, locale, version])
  @@index([key, channel, locale]) // runtime partial index: notification_templates_one_active
  @@map("notification_templates")
}

/// Notification outbox. Rows are written in the same DB transaction as the
/// business change; a pg-boss worker delivers them. Payload must not contain
/// clinical details, credentials or full identifiers.
model Notification {
  id           String              @id @map("_id") @default(uuid(7))
  userId       String?             @map("user_id")
  channel      NotificationChannel
  templateKey  String              @map("template_key")
  recipient    String
  payload      Json                @default("{}")
  status       NotificationStatus  @default(QUEUED)
  attempts     Int                 @default(0)
  lastError    String?             @map("last_error")
  sentAt       DateTime?           @map("sent_at")
  title        String?
  body         String?
  link         String?
  readAt       DateTime?           @map("read_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model PlatformSetting {
  key         String   @id @map("_id")
  value       Json
  description String?
  isSensitive Boolean  @default(false) @map("is_sensitive")
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model ExportJob {
  id            String       @id @map("_id") @default(uuid(7))
  exportType    String       @map("export_type")
  filters       Json         @default("{}")
  purpose       String
  status        ExportStatus @default(QUEUED)
  requestedById String       @map("requested_by_id")
  rowCount      Int?         @map("row_count")
  storageKey    String?      @map("storage_key")
  error         String?
  downloadCount Int          @default(0) @map("download_count")
  expiresAt     DateTime?    @map("expires_at")
  startedAt     DateTime?    @map("started_at")
  completedAt   DateTime?    @map("completed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([requestedById, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("export_jobs")
}

/// Append-only audit trail (UPDATE/DELETE blocked by trigger). Metadata is
/// redacted before insert: no passwords, tokens, clinical content, document
/// contents or full bank numbers.
model AuditEvent {
  id          String       @id @map("_id") @default(uuid(7))
  occurredAt  DateTime     @default(now()) @map("occurred_at")
  actorUserId String?      @map("actor_user_id")
  actorType   String       @default("USER") @map("actor_type") // USER | SYSTEM | WEBHOOK
  action      String
  entityType  String       @map("entity_type")
  entityId    String?      @map("entity_id")
  outcome     AuditOutcome @default(SUCCESS)
  requestId   String?      @map("request_id")
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")
  metadata    Json?

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@map("audit_events")
}

/// Every read of sensitive material (reports, prescriptions, identity
/// documents, payout accounts) is logged here, including denied attempts.
model SensitiveAccessLog {
  id           String   @id @map("_id") @default(uuid(7))
  actorUserId  String?  @map("actor_user_id")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  purpose      String
  granted      Boolean
  requestId    String?  @map("request_id")
  accessedAt   DateTime @default(now()) @map("accessed_at")

  @@index([resourceType, resourceId, accessedAt(sort: Desc)])
  @@index([actorUserId, accessedAt(sort: Desc)])
  @@map("sensitive_access_logs")
}

model ConsentRecord {
  id                String       @id @map("_id") @default(uuid(7))
  patientProfileId  String       @map("patient_profile_id")
  grantedByUserId   String       @map("granted_by_user_id")
  granteeProviderId String?      @map("grantee_provider_id")
  scope             ConsentScope
  purpose           String
  policyVersion     String       @map("policy_version")
  grantedAt         DateTime     @default(now()) @map("granted_at")
  expiresAt         DateTime?    @map("expires_at")
  withdrawnAt       DateTime?    @map("withdrawn_at")

  patient PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([patientProfileId, scope])
  @@index([granteeProviderId])
  @@map("consent_records")
}

model LegalHold {
  id          String    @id @map("_id") @default(uuid(7))
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  reason      String
  placedById  String    @map("placed_by_id")
  placedAt    DateTime  @default(now()) @map("placed_at")
  releasedAt  DateTime? @map("released_at")
  releasedById String?  @map("released_by_id")

  @@index([entityType, entityId])
  @@map("legal_holds")
}

model SecurityIncident {
  id                  String           @id @map("_id") @default(uuid(7))
  reference           String           @unique
  severity            IncidentSeverity
  status              IncidentStatus   @default(OPEN)
  title               String
  summary             String
  detectedAt          DateTime         @map("detected_at")
  containedAt         DateTime?        @map("contained_at")
  resolvedAt          DateTime?        @map("resolved_at")
  personalDataAffected Boolean         @default(false) @map("personal_data_affected")
  regulatorNotifiedAt DateTime?        @map("regulator_notified_at")
  createdById         String           @map("created_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([status, severity])
  @@map("security_incidents")
}

/// Web Push (VAPID) subscription for one browser or installed app. Deleted when
/// the push service says the endpoint is gone (404/410).
model PushSubscription {
  id         String    @id @map("_id") @default(uuid(7))
  userId     String    @map("user_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  failedAt   DateTime? @map("failed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("push_subscriptions")
}
