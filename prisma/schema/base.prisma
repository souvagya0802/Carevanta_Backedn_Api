// Carevanta — Prisma schema (multi-file).
//
// Conventions
// - Database: MongoDB (Atlas replica set). Prisma 6 with the MongoDB connector;
//   relations and referential actions are emulated by the client.
// - Primary keys are UUIDv7 strings (time-ordered) stored in `_id`, generated
//   by Prisma's `uuid(7)`; ids never change, so every relation uses
//   `onUpdate: NoAction`.
// - Collections and fields are snake_case via @@map / @map.
// - Money is stored as integer minor units (paise) in BigInt (Long) fields plus
//   an explicit ISO-4217 currency code. Never use floats for money.
// - Coordinates and ratings are Float (MongoDB has no fixed-point decimal in Prisma).
// - Indexes Prisma cannot express for MongoDB (partial unique indexes, 2dsphere,
//   text) are created at startup by src/lib/mongo-indexes.ts; CHECK-style rules
//   live in Zod schemas and service guards. See docs/database.md.

generator client {
  provider        = "prisma-client"
  output          = "../../generated/prisma"
  moduleFormat    = "esm"
  // Emit `.js` import specifiers so `tsc` output runs under Node's NodeNext
  // resolution without a bundler.
  importFileExtension = "js"
  // "native" for the developer's machine; debian-openssl-3.0.x for the Docker
  // image (node:22-bookworm-slim ships OpenSSL 3), so the right query engine is
  // always generated even if OpenSSL detection fails during the image build.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}
