// Carevanta — Prisma schema (multi-file).
//
// Conventions
// - Primary keys are UUIDv7 (time-ordered) generated by PostgreSQL 18 `uuidv7()`,
//   which keeps B-tree inserts append-mostly at high row counts.
// - Tables and columns are snake_case via @@map / @map.
// - Money is stored as integer minor units (paise) in BigInt columns plus an
//   explicit ISO-4217 currency code. Never use floats for money.
// - Timestamps are timestamptz(3).
// - Constraints Prisma cannot express (CHECK, EXCLUDE, append-only triggers) are
//   added as raw SQL in the migrations and documented in docs/database.md.

generator client {
  provider        = "prisma-client"
  output          = "../../generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
  moduleFormat    = "esm"
  // Emit `.js` import specifiers so `tsc` output runs under Node's NodeNext
  // resolution without a bundler.
  importFileExtension = "js"
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, btree_gist, pg_trgm]
}
