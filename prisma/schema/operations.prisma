// ─── Healthcare operations ──────────────────────────────────────────────────

enum AffiliationStatus {
  INVITED              // facility invited the doctor; awaiting doctor
  REQUESTED            // doctor requested to join; awaiting facility
  PENDING_VERIFICATION // both sides agreed; awaiting platform verification
  ACTIVE
  REJECTED
  SUSPENDED
  ENDED
  CANCELLED
}

enum AffiliationInitiator {
  FACILITY
  DOCTOR
  PLATFORM
}

enum EngagementType {
  FULL_TIME
  PART_TIME
  VISITING
  CONSULTANT
}

enum SlotStatus {
  OPEN
  BLOCKED
  CANCELLED
}

enum PatientRelationship {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_PLATFORM
  REJECTED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  PATIENT_APP
  PROVIDER_PORTAL
  ADMIN_CONSOLE
  WALK_IN
}

/// Who brought the customer. Drives commission eligibility: by default only
/// PLATFORM-attributed, completed services are commission-eligible.
enum Attribution {
  PLATFORM
  PROVIDER_DIRECT
  ADMIN_ASSISTED
}

enum ConsultationMode {
  IN_PERSON
  TELECONSULTATION
}

enum DiagnosticOrderStatus {
  REQUESTED
  CONFIRMED
  SAMPLE_COLLECTED
  PROCESSING
  REPORT_READY
  COMPLETED
  CANCELLED
  REJECTED
}

enum CollectionMode {
  CENTRE_VISIT
  HOME_COLLECTION
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  AMENDED
  WITHDRAWN
}

enum PrescriptionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PharmacyOrderStatus {
  PLACED
  PRESCRIPTION_REVIEW
  ACCEPTED
  REJECTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum FulfilmentMode {
  PICKUP
  DELIVERY
}

enum VehicleType {
  BLS
  ALS
  PATIENT_TRANSPORT
  NEONATAL
  MORTUARY
}

enum VehicleStatus {
  PENDING_VERIFICATION
  AVAILABLE
  ON_TRIP
  OUT_OF_SERVICE
  SUSPENDED
}

enum CrewRole {
  DRIVER
  EMT
  PARAMEDIC
  NURSE
}

/// LIVE requests are real emergencies. TEST requests exist for drills and QA
/// and must never trigger operator notifications or be shown as real.
enum DispatchMode {
  LIVE
  TEST
}

enum DispatchStatus {
  RECEIVED
  SEARCHING
  OFFERED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  PATIENT_ONBOARD
  AT_DESTINATION
  COMPLETED
  CANCELLED
  NO_PROVIDER_AVAILABLE
  ESCALATED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}

/// How acceptance was confirmed. An assignment is only ACCEPTED when the
/// operator confirmed it (app action, or a recorded phone confirmation).
enum ConfirmationSource {
  OPERATOR_APP
  OPERATOR_PHONE_CONFIRMED
}

/// The doctor ↔ facility relationship. One Doctor provider can hold many
/// affiliations; the hospital never owns or duplicates the doctor's identity.
model DoctorAffiliation {
  id                 String               @id @map("_id") @default(uuid(7))
  doctorProviderId   String               @map("doctor_provider_id")
  facilityProviderId String               @map("facility_provider_id")
  locationId         String?              @map("location_id")
  departmentId       String?              @map("department_id")
  roleTitle          String?              @map("role_title")
  engagementType     EngagementType       @default(VISITING) @map("engagement_type")
  consultationFeeMinor BigInt?            @map("consultation_fee_minor")
  currency           String               @default("INR")
  status             AffiliationStatus
  initiatedBy        AffiliationInitiator @map("initiated_by")
  requestedById      String?              @map("requested_by_id")
  doctorConfirmedAt  DateTime?            @map("doctor_confirmed_at")
  facilityConfirmedAt DateTime?           @map("facility_confirmed_at")
  verifiedById       String?              @map("verified_by_id")
  verifiedAt         DateTime?            @map("verified_at")
  startDate          DateTime?            @map("start_date")
  endDate            DateTime?            @map("end_date")
  statusReason       String?              @map("status_reason")
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  doctor     Provider          @relation("AffiliationDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  facility   Provider          @relation("AffiliationFacility", fields: [facilityProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location   ProviderLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  events     AffiliationEvent[]
  schedules  DoctorSchedule[]
  slots      AppointmentSlot[]
  appointments Appointment[]

  // At most one live (non-terminal) affiliation per doctor+facility.
  @@index([doctorProviderId, facilityProviderId]) // runtime partial index: doctor_affiliations_one_live
  @@index([facilityProviderId, status])
  @@index([doctorProviderId, status])
  @@index([status, createdAt])
  @@map("doctor_affiliations")
}

model AffiliationEvent {
  id            String             @id @map("_id") @default(uuid(7))
  affiliationId String             @map("affiliation_id")
  fromStatus    AffiliationStatus? @map("from_status")
  toStatus      AffiliationStatus  @map("to_status")
  actorUserId   String?            @map("actor_user_id")
  actorKind     String             @map("actor_kind") // DOCTOR | FACILITY | PLATFORM | SYSTEM
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  affiliation DoctorAffiliation @relation(fields: [affiliationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([affiliationId, createdAt])
  @@map("affiliation_events")
}

/// Recurring weekly template used to generate AppointmentSlots.
model DoctorSchedule {
  id               String    @id @map("_id") @default(uuid(7))
  doctorProviderId String    @map("doctor_provider_id")
  locationId       String    @map("location_id")
  affiliationId    String?   @map("affiliation_id")
  dayOfWeek        Int       @map("day_of_week")
  startMinute      Int       @map("start_minute")
  endMinute        Int       @map("end_minute")
  slotMinutes      Int       @map("slot_minutes")
  capacityPerSlot  Int       @default(1) @map("capacity_per_slot")
  feeMinor         BigInt?   @map("fee_minor")
  validFrom        DateTime  @map("valid_from")
  validTo          DateTime? @map("valid_to")
  isActive         Boolean   @default(true) @map("is_active")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  doctor      Provider           @relation("ScheduleDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location    ProviderLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  affiliation DoctorAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  slots       AppointmentSlot[]

  @@index([doctorProviderId, isActive])
  @@map("doctor_schedules")
}

/// Bookable capacity. Double booking is prevented by an atomic conditional
/// increment of bookedCount (CHECK 0 <= booked_count <= capacity) and a
/// database EXCLUDE constraint stopping a doctor from having overlapping open
/// slots at two locations (see migration SQL).
model AppointmentSlot {
  id               String     @id @map("_id") @default(uuid(7))
  doctorProviderId String     @map("doctor_provider_id")
  locationId       String     @map("location_id")
  affiliationId    String?    @map("affiliation_id")
  scheduleId       String?    @map("schedule_id")
  startsAt         DateTime   @map("starts_at")
  endsAt           DateTime   @map("ends_at")
  capacity         Int        @default(1)
  bookedCount      Int        @default(0) @map("booked_count")
  status           SlotStatus @default(OPEN)
  feeMinor         BigInt     @map("fee_minor")
  currency         String     @default("INR")
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  doctor       Provider           @relation("SlotDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location     ProviderLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  affiliation  DoctorAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  schedule     DoctorSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointments Appointment[]

  @@unique([doctorProviderId, locationId, startsAt])
  @@index([locationId, startsAt])
  @@index([startsAt]) // "appointments today" and other time-window reports
  @@index([doctorProviderId, startsAt]) // runtime partial index: appointment_slots_open_by_doctor
  @@map("appointment_slots")
}

/// Person receiving care. One account holder can manage dependants; the
/// account holder and the patient are deliberately different entities.
model PatientProfile {
  id                String              @id @map("_id") @default(uuid(7))
  accountUserId     String              @map("account_user_id")
  fullName          String              @map("full_name")
  relationship      PatientRelationship @default(SELF)
  dateOfBirth       DateTime?           @map("date_of_birth")
  gender            String?
  phone             String?
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  accountHolder    User               @relation("PatientAccountHolder", fields: [accountUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  appointments     Appointment[]
  diagnosticOrders DiagnosticOrder[]
  pharmacyOrders   PharmacyOrder[]
  prescriptions    Prescription[]
  consents         ConsentRecord[]
  transactions     ServiceTransaction[]

  @@index([accountUserId])
  @@map("patient_profiles")
}

model Appointment {
  id                 String            @id @map("_id") @default(uuid(7))
  reference          String            @unique
  patientProfileId   String            @map("patient_profile_id")
  bookedByUserId     String            @map("booked_by_user_id")
  doctorProviderId   String            @map("doctor_provider_id")
  facilityProviderId String            @map("facility_provider_id")
  locationId         String            @map("location_id")
  slotId             String            @map("slot_id")
  affiliationId      String?           @map("affiliation_id")
  mode               ConsultationMode  @default(IN_PERSON)
  status             AppointmentStatus @default(REQUESTED)
  source             BookingSource
  attribution        Attribution
  feeMinor           BigInt            @map("fee_minor")
  currency           String            @default("INR")
  reasonForVisit     String?           @map("reason_for_visit")
  rescheduledFromId  String?           @unique @map("rescheduled_from_id")
  idempotencyKey     String?           @map("idempotency_key")
  statusReason       String?           @map("status_reason")
  confirmedAt        DateTime?         @map("confirmed_at")
  checkedInAt        DateTime?         @map("checked_in_at")
  completedAt        DateTime?         @map("completed_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  patient         PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  doctor          Provider           @relation("AppointmentDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  facility        Provider           @relation("AppointmentFacility", fields: [facilityProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location        ProviderLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  slot            AppointmentSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  affiliation     DoctorAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rescheduledFrom Appointment?       @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rescheduledTo   Appointment?       @relation("Reschedule")
  events          AppointmentEvent[]
  transaction     ServiceTransaction?

  @@unique([bookedByUserId, idempotencyKey])
  // A patient cannot hold two live bookings in the same slot.
  @@index([patientProfileId, slotId]) // runtime partial index: appointments_patient_slot_live
  @@index([doctorProviderId, createdAt(sort: Desc)])
  @@index([facilityProviderId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([patientProfileId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([slotId])
  @@map("appointments")
}

model AppointmentEvent {
  id            String             @id @map("_id") @default(uuid(7))
  appointmentId String             @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  actorUserId   String?            @map("actor_user_id")
  actorKind     String             @map("actor_kind")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([appointmentId, createdAt])
  @@map("appointment_events")
}

model DiagnosticOrder {
  id               String                @id @map("_id") @default(uuid(7))
  reference        String                @unique
  patientProfileId String                @map("patient_profile_id")
  bookedByUserId   String                @map("booked_by_user_id")
  providerId       String                @map("provider_id")
  locationId       String?               @map("location_id")
  collectionMode   CollectionMode        @default(CENTRE_VISIT) @map("collection_mode")
  scheduledAt      DateTime?             @map("scheduled_at")
  collectionPincode String?              @map("collection_pincode")
  prescriptionId   String?               @map("prescription_id")
  status           DiagnosticOrderStatus @default(REQUESTED)
  source           BookingSource
  attribution      Attribution
  totalMinor       BigInt                @map("total_minor")
  currency         String                @default("INR")
  statusReason     String?               @map("status_reason")
  idempotencyKey   String?               @map("idempotency_key")
  completedAt      DateTime?             @map("completed_at")
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  patient      PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  provider     Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// Centre the patient visits (null for home collection); carried so order screens can show a map.
  location     ProviderLocation?     @relation("DiagnosticOrderLocation", fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prescription Prescription?         @relation(fields: [prescriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items        DiagnosticOrderItem[]
  reports      DiagnosticReport[]
  transaction  ServiceTransaction?

  @@unique([bookedByUserId, idempotencyKey])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("diagnostic_orders")
}

model DiagnosticOrderItem {
  id                String  @id @map("_id") @default(uuid(7))
  orderId           String  @map("order_id")
  providerServiceId String  @map("provider_service_id")
  serviceName       String  @map("service_name") // snapshot
  priceMinor        BigInt  @map("price_minor") // snapshot at booking time

  order           DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  providerService ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId])
  @@map("diagnostic_order_items")
}

/// Report metadata only — the PDF/structured result lives in private storage.
/// Corrections create a new version that supersedes the old one; old versions
/// are retained, never silently replaced.
model DiagnosticReport {
  id               String       @id @map("_id") @default(uuid(7))
  orderId          String       @map("order_id")
  version          Int          @default(1)
  status           ReportStatus @default(DRAFT)
  storageKey       String       @unique @map("storage_key")
  sha256           String
  supersedesId     String?      @unique @map("supersedes_id")
  correctionReason String?      @map("correction_reason")
  publishedById    String?      @map("published_by_id")
  publishedAt      DateTime?    @map("published_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  order      DiagnosticOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersedes DiagnosticReport? @relation("ReportVersion", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersededBy DiagnosticReport? @relation("ReportVersion")

  @@unique([orderId, version])
  @@map("diagnostic_reports")
}

model Prescription {
  id               String                   @id @map("_id") @default(uuid(7))
  patientProfileId String                   @map("patient_profile_id")
  uploadedByUserId String                   @map("uploaded_by_user_id")
  issuedByDoctorProviderId String?          @map("issued_by_doctor_provider_id")
  storageKey       String                   @unique @map("storage_key")
  sha256           String
  reviewStatus     PrescriptionReviewStatus @default(PENDING) @map("review_status")
  reviewedByUserId String?                  @map("reviewed_by_user_id")
  reviewedAt       DateTime?                @map("reviewed_at")
  reviewNote       String?                  @map("review_note")
  issuedOn         DateTime?                @map("issued_on")
  validUntil       DateTime?                @map("valid_until")
  createdAt        DateTime                 @default(now()) @map("created_at")

  patient          PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  diagnosticOrders DiagnosticOrder[]
  pharmacyOrders   PharmacyOrder[]

  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("prescriptions")
}

model PharmacyInventory {
  id                String   @id @map("_id") @default(uuid(7))
  providerId        String   @map("provider_id")
  locationId        String   @map("location_id")
  medicineId        String   @map("medicine_id")
  batchNumber       String   @map("batch_number")
  expiryDate        DateTime @map("expiry_date")
  quantityOnHand    Int      @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  mrpMinor          BigInt   @map("mrp_minor")
  sellingPriceMinor BigInt   @map("selling_price_minor")
  currency          String   @default("INR")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  provider   Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location   ProviderLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  medicine   Medicine            @relation(fields: [medicineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItems PharmacyOrderItem[]

  @@unique([locationId, medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([providerId])
  @@map("pharmacy_inventory")
}

model PharmacyOrder {
  id               String              @id @map("_id") @default(uuid(7))
  reference        String              @unique
  patientProfileId String              @map("patient_profile_id")
  bookedByUserId   String              @map("booked_by_user_id")
  providerId       String              @map("provider_id")
  locationId       String?             @map("location_id")
  fulfilment       FulfilmentMode      @default(PICKUP)
  deliveryPincode  String?             @map("delivery_pincode")
  prescriptionId   String?             @map("prescription_id")
  status           PharmacyOrderStatus @default(PLACED)
  source           BookingSource
  attribution      Attribution
  totalMinor       BigInt              @map("total_minor")
  currency         String              @default("INR")
  statusReason     String?             @map("status_reason")
  idempotencyKey   String?             @map("idempotency_key")
  completedAt      DateTime?           @map("completed_at")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  patient      PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  provider     Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prescription Prescription?       @relation(fields: [prescriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items        PharmacyOrderItem[]
  transaction  ServiceTransaction?

  @@unique([bookedByUserId, idempotencyKey])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("pharmacy_orders")
}

model PharmacyOrderItem {
  id             String  @id @map("_id") @default(uuid(7))
  orderId        String  @map("order_id")
  medicineId     String  @map("medicine_id")
  inventoryId    String? @map("inventory_id")
  quantity       Int
  unitPriceMinor BigInt  @map("unit_price_minor")
  // Substitution is only recorded with pharmacist + patient authorisation.
  substitutedForMedicineId String? @map("substituted_for_medicine_id")

  order     PharmacyOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicine  Medicine           @relation(fields: [medicineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory PharmacyInventory? @relation(fields: [inventoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId])
  @@map("pharmacy_order_items")
}

model AmbulanceVehicle {
  id                 String        @id @map("_id") @default(uuid(7))
  operatorProviderId String        @map("operator_provider_id")
  baseLocationId     String?       @map("base_location_id")
  registrationNumber String        @unique @map("registration_number")
  vehicleType        VehicleType   @map("vehicle_type")
  status             VehicleStatus @default(PENDING_VERIFICATION)
  equipment          String[]      @default([])
  insuranceValidUntil DateTime?    @map("insurance_valid_until")
  fitnessValidUntil  DateTime?     @map("fitness_valid_until")
  lastKnownLatitude  Float?      @map("last_known_latitude")
  lastKnownLongitude Float?      @map("last_known_longitude")
  lastLocationAt     DateTime?     @map("last_location_at")
  verifiedAt         DateTime?     @map("verified_at")
  verifiedById       String?       @map("verified_by_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  operator     Provider             @relation(fields: [operatorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  baseLocation ProviderLocation?    @relation(fields: [baseLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignments  DispatchAssignment[]

  @@index([operatorProviderId, status])
  @@map("ambulance_vehicles")
}

model AmbulanceCrewMember {
  id                 String   @id @map("_id") @default(uuid(7))
  operatorProviderId String   @map("operator_provider_id")
  userId             String?  @map("user_id")
  fullName           String   @map("full_name")
  role               CrewRole
  licenseNumber      String?  @map("license_number")
  licenseValidUntil  DateTime? @map("license_valid_until")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  operator Provider @relation(fields: [operatorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([operatorProviderId])
  @@map("ambulance_crew_members")
}

model DispatchRequest {
  id                    String         @id @map("_id") @default(uuid(7))
  reference             String         @unique
  mode                  DispatchMode
  status                DispatchStatus @default(RECEIVED)
  requestedByUserId     String?        @map("requested_by_user_id")
  callerPhone           String?        @map("caller_phone")
  pickupLatitude        Float?       @map("pickup_latitude")
  pickupLongitude       Float?       @map("pickup_longitude")
  pickupAddress         String?        @map("pickup_address")
  pickupDistrict        String?        @map("pickup_district")
  destinationProviderId String?        @map("destination_provider_id")
  requiredVehicleType   VehicleType?   @map("required_vehicle_type")
  emergencyGuidanceShownAt DateTime?   @map("emergency_guidance_shown_at")
  escalatedAt           DateTime?      @map("escalated_at")
  escalationNote        String?        @map("escalation_note")
  closedAt              DateTime?      @map("closed_at")
  closeReason           String?        @map("close_reason")
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  assignments DispatchAssignment[]
  events      DispatchEvent[]
  transaction ServiceTransaction?

  @@index([status, createdAt(sort: Desc)])
  @@index([mode, createdAt(sort: Desc)])
  @@map("dispatch_requests")
}

model DispatchAssignment {
  id                 String              @id @map("_id") @default(uuid(7))
  requestId          String              @map("request_id")
  operatorProviderId String              @map("operator_provider_id")
  vehicleId          String?             @map("vehicle_id")
  status             AssignmentStatus    @default(OFFERED)
  confirmationSource ConfirmationSource? @map("confirmation_source")
  confirmedByUserId  String?             @map("confirmed_by_user_id")
  offeredAt          DateTime            @default(now()) @map("offered_at")
  respondedAt        DateTime?           @map("responded_at")
  etaMinutes         Int?                @map("eta_minutes")
  note               String?

  request  DispatchRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  operator Provider          @relation(fields: [operatorProviderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vehicle  AmbulanceVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Only one accepted assignment per request.
  @@index([requestId])
  @@index([vehicleId, status])
  @@map("dispatch_assignments")
}

model DispatchEvent {
  id          String          @id @map("_id") @default(uuid(7))
  requestId   String          @map("request_id")
  fromStatus  DispatchStatus? @map("from_status")
  toStatus    DispatchStatus  @map("to_status")
  actorUserId String?         @map("actor_user_id")
  actorKind   String          @map("actor_kind")
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")

  request DispatchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([requestId, createdAt])
  @@map("dispatch_events")
}
