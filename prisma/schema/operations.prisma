// ─── Healthcare operations ──────────────────────────────────────────────────

enum AffiliationStatus {
  INVITED              // facility invited the doctor; awaiting doctor
  REQUESTED            // doctor requested to join; awaiting facility
  PENDING_VERIFICATION // both sides agreed; awaiting platform verification
  ACTIVE
  REJECTED
  SUSPENDED
  ENDED
  CANCELLED
}

enum AffiliationInitiator {
  FACILITY
  DOCTOR
  PLATFORM
}

enum EngagementType {
  FULL_TIME
  PART_TIME
  VISITING
  CONSULTANT
}

enum SlotStatus {
  OPEN
  BLOCKED
  CANCELLED
}

enum PatientRelationship {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_PLATFORM
  REJECTED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  PATIENT_APP
  PROVIDER_PORTAL
  ADMIN_CONSOLE
  WALK_IN
}

/// Who brought the customer. Drives commission eligibility: by default only
/// PLATFORM-attributed, completed services are commission-eligible.
enum Attribution {
  PLATFORM
  PROVIDER_DIRECT
  ADMIN_ASSISTED
}

enum ConsultationMode {
  IN_PERSON
  TELECONSULTATION
}

enum DiagnosticOrderStatus {
  REQUESTED
  CONFIRMED
  SAMPLE_COLLECTED
  PROCESSING
  REPORT_READY
  COMPLETED
  CANCELLED
  REJECTED
}

enum CollectionMode {
  CENTRE_VISIT
  HOME_COLLECTION
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  AMENDED
  WITHDRAWN
}

enum PrescriptionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PharmacyOrderStatus {
  PLACED
  PRESCRIPTION_REVIEW
  ACCEPTED
  REJECTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum FulfilmentMode {
  PICKUP
  DELIVERY
}

enum VehicleType {
  BLS
  ALS
  PATIENT_TRANSPORT
  NEONATAL
  MORTUARY
}

enum VehicleStatus {
  PENDING_VERIFICATION
  AVAILABLE
  ON_TRIP
  OUT_OF_SERVICE
  SUSPENDED
}

enum CrewRole {
  DRIVER
  EMT
  PARAMEDIC
  NURSE
}

/// LIVE requests are real emergencies. TEST requests exist for drills and QA
/// and must never trigger operator notifications or be shown as real.
enum DispatchMode {
  LIVE
  TEST
}

enum DispatchStatus {
  RECEIVED
  SEARCHING
  OFFERED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  PATIENT_ONBOARD
  AT_DESTINATION
  COMPLETED
  CANCELLED
  NO_PROVIDER_AVAILABLE
  ESCALATED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}

/// How acceptance was confirmed. An assignment is only ACCEPTED when the
/// operator confirmed it (app action, or a recorded phone confirmation).
enum ConfirmationSource {
  OPERATOR_APP
  OPERATOR_PHONE_CONFIRMED
}

/// The doctor ↔ facility relationship. One Doctor provider can hold many
/// affiliations; the hospital never owns or duplicates the doctor's identity.
model DoctorAffiliation {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  doctorProviderId   String               @map("doctor_provider_id") @db.Uuid
  facilityProviderId String               @map("facility_provider_id") @db.Uuid
  locationId         String?              @map("location_id") @db.Uuid
  departmentId       String?              @map("department_id") @db.Uuid
  roleTitle          String?              @map("role_title") @db.VarChar(120)
  engagementType     EngagementType       @default(VISITING) @map("engagement_type")
  consultationFeeMinor BigInt?            @map("consultation_fee_minor")
  currency           String               @default("INR") @db.Char(3)
  status             AffiliationStatus
  initiatedBy        AffiliationInitiator @map("initiated_by")
  requestedById      String?              @map("requested_by_id") @db.Uuid
  doctorConfirmedAt  DateTime?            @map("doctor_confirmed_at") @db.Timestamptz(3)
  facilityConfirmedAt DateTime?           @map("facility_confirmed_at") @db.Timestamptz(3)
  verifiedById       String?              @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime?            @map("verified_at") @db.Timestamptz(3)
  startDate          DateTime?            @map("start_date") @db.Date
  endDate            DateTime?            @map("end_date") @db.Date
  statusReason       String?              @map("status_reason") @db.VarChar(1000)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctor     Provider          @relation("AffiliationDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict)
  facility   Provider          @relation("AffiliationFacility", fields: [facilityProviderId], references: [id], onDelete: Restrict)
  location   ProviderLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  events     AffiliationEvent[]
  schedules  DoctorSchedule[]
  slots      AppointmentSlot[]
  appointments Appointment[]

  // At most one live (non-terminal) affiliation per doctor+facility.
  @@unique([doctorProviderId, facilityProviderId], where: raw("status = ANY (ARRAY['INVITED'::\"AffiliationStatus\", 'REQUESTED'::\"AffiliationStatus\", 'PENDING_VERIFICATION'::\"AffiliationStatus\", 'ACTIVE'::\"AffiliationStatus\", 'SUSPENDED'::\"AffiliationStatus\"])"), map: "doctor_affiliations_one_live")
  @@index([facilityProviderId, status])
  @@index([doctorProviderId, status])
  @@index([status, createdAt])
  @@map("doctor_affiliations")
}

model AffiliationEvent {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  affiliationId String             @map("affiliation_id") @db.Uuid
  fromStatus    AffiliationStatus? @map("from_status")
  toStatus      AffiliationStatus  @map("to_status")
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  actorKind     String             @map("actor_kind") @db.VarChar(24) // DOCTOR | FACILITY | PLATFORM | SYSTEM
  note          String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  affiliation DoctorAffiliation @relation(fields: [affiliationId], references: [id], onDelete: Cascade)

  @@index([affiliationId, createdAt])
  @@map("affiliation_events")
}

/// Recurring weekly template used to generate AppointmentSlots.
model DoctorSchedule {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  doctorProviderId String    @map("doctor_provider_id") @db.Uuid
  locationId       String    @map("location_id") @db.Uuid
  affiliationId    String?   @map("affiliation_id") @db.Uuid
  dayOfWeek        Int       @map("day_of_week") @db.SmallInt
  startMinute      Int       @map("start_minute") @db.SmallInt
  endMinute        Int       @map("end_minute") @db.SmallInt
  slotMinutes      Int       @map("slot_minutes") @db.SmallInt
  capacityPerSlot  Int       @default(1) @map("capacity_per_slot") @db.SmallInt
  feeMinor         BigInt?   @map("fee_minor")
  validFrom        DateTime  @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctor      Provider           @relation("ScheduleDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict)
  location    ProviderLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  affiliation DoctorAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  slots       AppointmentSlot[]

  @@index([doctorProviderId, isActive])
  @@map("doctor_schedules")
}

/// Bookable capacity. Double booking is prevented by an atomic conditional
/// increment of bookedCount (CHECK 0 <= booked_count <= capacity) and a
/// database EXCLUDE constraint stopping a doctor from having overlapping open
/// slots at two locations (see migration SQL).
model AppointmentSlot {
  id               String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  doctorProviderId String     @map("doctor_provider_id") @db.Uuid
  locationId       String     @map("location_id") @db.Uuid
  affiliationId    String?    @map("affiliation_id") @db.Uuid
  scheduleId       String?    @map("schedule_id") @db.Uuid
  startsAt         DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime   @map("ends_at") @db.Timestamptz(3)
  capacity         Int        @default(1) @db.SmallInt
  bookedCount      Int        @default(0) @map("booked_count") @db.SmallInt
  status           SlotStatus @default(OPEN)
  feeMinor         BigInt     @map("fee_minor")
  currency         String     @default("INR") @db.Char(3)
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctor       Provider           @relation("SlotDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict)
  location     ProviderLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  affiliation  DoctorAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  schedule     DoctorSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([doctorProviderId, locationId, startsAt])
  @@index([locationId, startsAt])
  @@index([startsAt]) // "appointments today" and other time-window reports
  @@index([doctorProviderId, startsAt], where: raw("status = 'OPEN'"), map: "appointment_slots_open_by_doctor")
  @@map("appointment_slots")
}

/// Person receiving care. One account holder can manage dependants; the
/// account holder and the patient are deliberately different entities.
model PatientProfile {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountUserId     String              @map("account_user_id") @db.Uuid
  fullName          String              @map("full_name") @db.VarChar(160)
  relationship      PatientRelationship @default(SELF)
  dateOfBirth       DateTime?           @map("date_of_birth") @db.Date
  gender            String?             @db.VarChar(24)
  phone             String?             @db.VarChar(16)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  accountHolder    User               @relation("PatientAccountHolder", fields: [accountUserId], references: [id], onDelete: Restrict)
  appointments     Appointment[]
  diagnosticOrders DiagnosticOrder[]
  pharmacyOrders   PharmacyOrder[]
  prescriptions    Prescription[]
  consents         ConsentRecord[]
  transactions     ServiceTransaction[]

  @@unique([accountUserId], where: raw("relationship = 'SELF'"), map: "patient_profiles_one_self")
  @@index([accountUserId])
  @@map("patient_profiles")
}

model Appointment {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference          String            @unique @db.VarChar(24)
  patientProfileId   String            @map("patient_profile_id") @db.Uuid
  bookedByUserId     String            @map("booked_by_user_id") @db.Uuid
  doctorProviderId   String            @map("doctor_provider_id") @db.Uuid
  facilityProviderId String            @map("facility_provider_id") @db.Uuid
  locationId         String            @map("location_id") @db.Uuid
  slotId             String            @map("slot_id") @db.Uuid
  affiliationId      String?           @map("affiliation_id") @db.Uuid
  mode               ConsultationMode  @default(IN_PERSON)
  status             AppointmentStatus @default(REQUESTED)
  source             BookingSource
  attribution        Attribution
  feeMinor           BigInt            @map("fee_minor")
  currency           String            @default("INR") @db.Char(3)
  reasonForVisit     String?           @map("reason_for_visit") @db.VarChar(500)
  rescheduledFromId  String?           @unique @map("rescheduled_from_id") @db.Uuid
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(80)
  statusReason       String?           @map("status_reason") @db.VarChar(1000)
  confirmedAt        DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  checkedInAt        DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient         PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  doctor          Provider           @relation("AppointmentDoctor", fields: [doctorProviderId], references: [id], onDelete: Restrict)
  facility        Provider           @relation("AppointmentFacility", fields: [facilityProviderId], references: [id], onDelete: Restrict)
  location        ProviderLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  slot            AppointmentSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  affiliation     DoctorAffiliation? @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  rescheduledFrom Appointment?       @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo   Appointment?       @relation("Reschedule")
  events          AppointmentEvent[]
  transaction     ServiceTransaction?

  @@unique([bookedByUserId, idempotencyKey])
  // A patient cannot hold two live bookings in the same slot.
  @@unique([patientProfileId, slotId], where: raw("status = ANY (ARRAY['REQUESTED'::\"AppointmentStatus\", 'CONFIRMED'::\"AppointmentStatus\", 'CHECKED_IN'::\"AppointmentStatus\"])"), map: "appointments_patient_slot_live")
  @@index([doctorProviderId, createdAt(sort: Desc)])
  @@index([facilityProviderId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([patientProfileId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([slotId])
  @@map("appointments")
}

model AppointmentEvent {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  actorKind     String             @map("actor_kind") @db.VarChar(24)
  note          String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_events")
}

model DiagnosticOrder {
  id               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference        String                @unique @db.VarChar(24)
  patientProfileId String                @map("patient_profile_id") @db.Uuid
  bookedByUserId   String                @map("booked_by_user_id") @db.Uuid
  providerId       String                @map("provider_id") @db.Uuid
  locationId       String?               @map("location_id") @db.Uuid
  collectionMode   CollectionMode        @default(CENTRE_VISIT) @map("collection_mode")
  scheduledAt      DateTime?             @map("scheduled_at") @db.Timestamptz(3)
  collectionPincode String?              @map("collection_pincode") @db.Char(6)
  prescriptionId   String?               @map("prescription_id") @db.Uuid
  status           DiagnosticOrderStatus @default(REQUESTED)
  source           BookingSource
  attribution      Attribution
  totalMinor       BigInt                @map("total_minor")
  currency         String                @default("INR") @db.Char(3)
  statusReason     String?               @map("status_reason") @db.VarChar(1000)
  idempotencyKey   String?               @map("idempotency_key") @db.VarChar(80)
  completedAt      DateTime?             @map("completed_at") @db.Timestamptz(3)
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient      PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  provider     Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  prescription Prescription?         @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items        DiagnosticOrderItem[]
  reports      DiagnosticReport[]
  transaction  ServiceTransaction?

  @@unique([bookedByUserId, idempotencyKey])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("diagnostic_orders")
}

model DiagnosticOrderItem {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  providerServiceId String  @map("provider_service_id") @db.Uuid
  serviceName       String  @map("service_name") @db.VarChar(200) // snapshot
  priceMinor        BigInt  @map("price_minor") // snapshot at booking time

  order           DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerService ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("diagnostic_order_items")
}

/// Report metadata only — the PDF/structured result lives in private storage.
/// Corrections create a new version that supersedes the old one; old versions
/// are retained, never silently replaced.
model DiagnosticReport {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  version          Int          @default(1)
  status           ReportStatus @default(DRAFT)
  storageKey       String       @unique @map("storage_key") @db.VarChar(300)
  sha256           String       @db.Char(64)
  supersedesId     String?      @unique @map("supersedes_id") @db.Uuid
  correctionReason String?      @map("correction_reason") @db.VarChar(1000)
  publishedById    String?      @map("published_by_id") @db.Uuid
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order      DiagnosticOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supersedes DiagnosticReport? @relation("ReportVersion", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy DiagnosticReport? @relation("ReportVersion")

  @@unique([orderId, version])
  @@map("diagnostic_reports")
}

model Prescription {
  id               String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  patientProfileId String                   @map("patient_profile_id") @db.Uuid
  uploadedByUserId String                   @map("uploaded_by_user_id") @db.Uuid
  issuedByDoctorProviderId String?          @map("issued_by_doctor_provider_id") @db.Uuid
  storageKey       String                   @unique @map("storage_key") @db.VarChar(300)
  sha256           String                   @db.Char(64)
  reviewStatus     PrescriptionReviewStatus @default(PENDING) @map("review_status")
  reviewedByUserId String?                  @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?                  @map("review_note") @db.VarChar(1000)
  issuedOn         DateTime?                @map("issued_on") @db.Date
  validUntil       DateTime?                @map("valid_until") @db.Date
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  patient          PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  diagnosticOrders DiagnosticOrder[]
  pharmacyOrders   PharmacyOrder[]

  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("prescriptions")
}

model PharmacyInventory {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId        String   @map("provider_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  medicineId        String   @map("medicine_id") @db.Uuid
  batchNumber       String   @map("batch_number") @db.VarChar(64)
  expiryDate        DateTime @map("expiry_date") @db.Date
  quantityOnHand    Int      @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  mrpMinor          BigInt   @map("mrp_minor")
  sellingPriceMinor BigInt   @map("selling_price_minor")
  currency          String   @default("INR") @db.Char(3)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider   Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  location   ProviderLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  medicine   Medicine            @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  orderItems PharmacyOrderItem[]

  @@unique([locationId, medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([providerId])
  @@map("pharmacy_inventory")
}

model PharmacyOrder {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference        String              @unique @db.VarChar(24)
  patientProfileId String              @map("patient_profile_id") @db.Uuid
  bookedByUserId   String              @map("booked_by_user_id") @db.Uuid
  providerId       String              @map("provider_id") @db.Uuid
  locationId       String?             @map("location_id") @db.Uuid
  fulfilment       FulfilmentMode      @default(PICKUP)
  deliveryPincode  String?             @map("delivery_pincode") @db.Char(6)
  prescriptionId   String?             @map("prescription_id") @db.Uuid
  status           PharmacyOrderStatus @default(PLACED)
  source           BookingSource
  attribution      Attribution
  totalMinor       BigInt              @map("total_minor")
  currency         String              @default("INR") @db.Char(3)
  statusReason     String?             @map("status_reason") @db.VarChar(1000)
  idempotencyKey   String?             @map("idempotency_key") @db.VarChar(80)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient      PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  provider     Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  prescription Prescription?       @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items        PharmacyOrderItem[]
  transaction  ServiceTransaction?

  @@unique([bookedByUserId, idempotencyKey])
  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("pharmacy_orders")
}

model PharmacyOrderItem {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  medicineId     String  @map("medicine_id") @db.Uuid
  inventoryId    String? @map("inventory_id") @db.Uuid
  quantity       Int
  unitPriceMinor BigInt  @map("unit_price_minor")
  // Substitution is only recorded with pharmacist + patient authorisation.
  substitutedForMedicineId String? @map("substituted_for_medicine_id") @db.Uuid

  order     PharmacyOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine  Medicine           @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  inventory PharmacyInventory? @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("pharmacy_order_items")
}

model AmbulanceVehicle {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operatorProviderId String        @map("operator_provider_id") @db.Uuid
  baseLocationId     String?       @map("base_location_id") @db.Uuid
  registrationNumber String        @unique @map("registration_number") @db.VarChar(16)
  vehicleType        VehicleType   @map("vehicle_type")
  status             VehicleStatus @default(PENDING_VERIFICATION)
  equipment          String[]      @default([]) @db.VarChar(64)
  insuranceValidUntil DateTime?    @map("insurance_valid_until") @db.Date
  fitnessValidUntil  DateTime?     @map("fitness_valid_until") @db.Date
  lastKnownLatitude  Decimal?      @map("last_known_latitude") @db.Decimal(9, 6)
  lastKnownLongitude Decimal?      @map("last_known_longitude") @db.Decimal(9, 6)
  lastLocationAt     DateTime?     @map("last_location_at") @db.Timestamptz(3)
  verifiedAt         DateTime?     @map("verified_at") @db.Timestamptz(3)
  verifiedById       String?       @map("verified_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator     Provider             @relation(fields: [operatorProviderId], references: [id], onDelete: Restrict)
  baseLocation ProviderLocation?    @relation(fields: [baseLocationId], references: [id], onDelete: SetNull)
  assignments  DispatchAssignment[]

  @@index([operatorProviderId, status])
  @@map("ambulance_vehicles")
}

model AmbulanceCrewMember {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operatorProviderId String   @map("operator_provider_id") @db.Uuid
  userId             String?  @map("user_id") @db.Uuid
  fullName           String   @map("full_name") @db.VarChar(160)
  role               CrewRole
  licenseNumber      String?  @map("license_number") @db.VarChar(64)
  licenseValidUntil  DateTime? @map("license_valid_until") @db.Date
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator Provider @relation(fields: [operatorProviderId], references: [id], onDelete: Restrict)

  @@index([operatorProviderId])
  @@map("ambulance_crew_members")
}

model DispatchRequest {
  id                    String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference             String         @unique @db.VarChar(24)
  mode                  DispatchMode
  status                DispatchStatus @default(RECEIVED)
  requestedByUserId     String?        @map("requested_by_user_id") @db.Uuid
  callerPhone           String?        @map("caller_phone") @db.VarChar(16)
  pickupLatitude        Decimal?       @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude       Decimal?       @map("pickup_longitude") @db.Decimal(9, 6)
  pickupAddress         String?        @map("pickup_address") @db.VarChar(500)
  pickupDistrict        String?        @map("pickup_district") @db.VarChar(80)
  destinationProviderId String?        @map("destination_provider_id") @db.Uuid
  requiredVehicleType   VehicleType?   @map("required_vehicle_type")
  emergencyGuidanceShownAt DateTime?   @map("emergency_guidance_shown_at") @db.Timestamptz(3)
  escalatedAt           DateTime?      @map("escalated_at") @db.Timestamptz(3)
  escalationNote        String?        @map("escalation_note") @db.VarChar(1000)
  closedAt              DateTime?      @map("closed_at") @db.Timestamptz(3)
  closeReason           String?        @map("close_reason") @db.VarChar(500)
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments DispatchAssignment[]
  events      DispatchEvent[]
  transaction ServiceTransaction?

  @@index([status, createdAt(sort: Desc)])
  @@index([mode, createdAt(sort: Desc)])
  @@map("dispatch_requests")
}

model DispatchAssignment {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId          String              @map("request_id") @db.Uuid
  operatorProviderId String              @map("operator_provider_id") @db.Uuid
  vehicleId          String?             @map("vehicle_id") @db.Uuid
  status             AssignmentStatus    @default(OFFERED)
  confirmationSource ConfirmationSource? @map("confirmation_source")
  confirmedByUserId  String?             @map("confirmed_by_user_id") @db.Uuid
  offeredAt          DateTime            @default(now()) @map("offered_at") @db.Timestamptz(3)
  respondedAt        DateTime?           @map("responded_at") @db.Timestamptz(3)
  etaMinutes         Int?                @map("eta_minutes")
  note               String?             @db.VarChar(500)

  request  DispatchRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  operator Provider          @relation(fields: [operatorProviderId], references: [id], onDelete: Restrict)
  vehicle  AmbulanceVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Only one accepted assignment per request.
  @@unique([requestId], where: raw("status = 'ACCEPTED'"), map: "dispatch_assignments_one_accepted")
  @@index([requestId])
  @@index([vehicleId, status])
  @@map("dispatch_assignments")
}

model DispatchEvent {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId   String          @map("request_id") @db.Uuid
  fromStatus  DispatchStatus? @map("from_status")
  toStatus    DispatchStatus  @map("to_status")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  actorKind   String          @map("actor_kind") @db.VarChar(24)
  note        String?         @db.VarChar(1000)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  request DispatchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("dispatch_events")
}
