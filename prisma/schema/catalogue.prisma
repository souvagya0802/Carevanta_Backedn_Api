// ─── Clinical and service catalogue ─────────────────────────────────────────
//
// A platform-controlled taxonomy. Providers map their offerings onto it, so
// "Cardiology", "Heart Dept" and "Heart Care Unit" are one searchable thing.
// Condition → speciality mappings drive discovery ("liver disease" →
// Gastroenterology/Hepatology). They are *routing hints for finding a relevant
// specialist*, never diagnoses, and only APPROVED mappings reviewed by someone
// other than the proposer are used by search.

enum MappingReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  RETIRED
}

enum MappingRelevance {
  PRIMARY
  SECONDARY
}

enum ServiceCategory {
  CONSULTATION
  DIAGNOSTIC_TEST
  IMAGING
  PROCEDURE
  SURGERY
  PHARMACY
  AMBULANCE
  HOME_CARE
  OTHER
}

enum MedicineSchedule {
  OTC
  SCHEDULE_G
  SCHEDULE_H
  SCHEDULE_H1
  SCHEDULE_X
  OTHER
}

model Speciality {
  id          String   @id @map("_id") @default(uuid(7))
  code        String   @unique
  name        String   @unique
  parentId    String?  @map("parent_id")
  description String?
  /// Everyday words patients use for this speciality ("child doctor", "skin specialist", "shishu"). Used by search only.
  synonyms    String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Speciality?                  @relation("SpecialityTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children    Speciality[]                 @relation("SpecialityTree")
  doctors     DoctorSpeciality[]
  conditions  ConditionSpecialityMapping[]
  departments Department[]
  services    Service[]

  @@index([parentId])
  @@map("specialities")
}

/// Searchable patient-facing term (disease, condition or symptom).
model Condition {
  id          String   @id @map("_id") @default(uuid(7))
  name        String   @unique
  slug        String   @unique
  kind        String   @default("CONDITION") // CONDITION | SYMPTOM
  synonyms    String[] @default([])
  isRedFlag   Boolean  @default(false) @map("is_red_flag") // e.g. chest pain → show emergency guidance first
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  specialities ConditionSpecialityMapping[]

  @@index([synonyms])
  @@map("conditions")
}

model ConditionSpecialityMapping {
  id           String              @id @map("_id") @default(uuid(7))
  conditionId  String              @map("condition_id")
  specialityId String              @map("speciality_id")
  relevance    MappingRelevance    @default(PRIMARY)
  reviewStatus MappingReviewStatus @default(DRAFT) @map("review_status")
  rationale    String?
  proposedById String?             @map("proposed_by_id")
  reviewedById String?             @map("reviewed_by_id")
  reviewedAt   DateTime?           @map("reviewed_at")
  reviewNote   String?             @map("review_note")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  condition  Condition  @relation(fields: [conditionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  speciality Speciality @relation(fields: [specialityId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([conditionId, specialityId])
  @@index([specialityId])
  @@index([reviewStatus])
  @@map("condition_speciality_mappings")
}

model Department {
  id           String   @id @map("_id") @default(uuid(7))
  code         String   @unique
  name         String   @unique
  specialityId String?  @map("speciality_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  speciality Speciality?          @relation(fields: [specialityId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  facilities FacilityDepartment[]
  affiliations DoctorAffiliation[]

  @@map("departments")
}

/// A department offered by a hospital/clinic. Creating it does not make it a
/// verified claim; `verifiedAt` is set by the verification team.
model FacilityDepartment {
  id           String    @id @map("_id") @default(uuid(7))
  providerId   String    @map("provider_id")
  departmentId String    @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  provider   Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([providerId, departmentId])
  @@index([departmentId, isActive])
  @@map("facility_departments")
}

/// Facility capability such as ICU, blood bank, CT scanner, wheelchair access.
model Amenity {
  id        String   @id @map("_id") @default(uuid(7))
  code      String   @unique
  name      String
  category  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  providers ProviderAmenity[]

  @@map("amenities")
}

model ProviderAmenity {
  id String @id @default(uuid(7)) @map("_id")
  providerId   String    @map("provider_id")
  amenityId    String    @map("amenity_id")
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([providerId, amenityId])
  @@index([amenityId])
  @@map("provider_amenities")
}

model Service {
  id                     String          @id @map("_id") @default(uuid(7))
  code                   String          @unique
  name                   String
  category               ServiceCategory
  specialityId           String?         @map("speciality_id")
  description            String?
  requiresPrescription   Boolean         @default(false) @map("requires_prescription")
  // Diagnostic-specific attributes (null for other categories)
  sampleType             String?         @map("sample_type")
  fastingRequired        Boolean?        @map("fasting_required")
  preparationInstructions String?        @map("preparation_instructions")
  isPanel                Boolean         @default(false) @map("is_panel")
  /// Everyday words patients use for this test ("sugar test", "blood test"). Used by search only.
  synonyms               String[]        @default([])
  isActive               Boolean         @default(true) @map("is_active")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  speciality       Speciality?        @relation(fields: [specialityId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  panelComponents  ServicePanelItem[] @relation("Panel")
  partOfPanels     ServicePanelItem[] @relation("Component")
  offerings        ProviderService[]

  @@index([category, isActive])
  @@index([name], map: "services_name_trgm_idx")
  @@map("services")
}

model ServicePanelItem {
  id String @id @default(uuid(7)) @map("_id")
  panelId     String @map("panel_id")
  componentId String @map("component_id")

  panel     Service @relation("Panel", fields: [panelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  component Service @relation("Component", fields: [componentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([panelId, componentId])
  @@map("service_panel_items")
}

/// A provider's priced offering of a catalogue service at a location.
model ProviderService {
  id                   String   @id @map("_id") @default(uuid(7))
  providerId           String   @map("provider_id")
  serviceId            String   @map("service_id")
  locationId           String?  @map("location_id")
  priceMinor           BigInt   @map("price_minor")
  currency             String   @default("INR")
  homeServiceAvailable Boolean  @default(false) @map("home_service_available")
  turnaroundHours      Int?     @map("turnaround_hours")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  provider Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service  Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location ProviderLocation?   @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderItems DiagnosticOrderItem[]

  @@unique([providerId, serviceId, locationId])
  // NULL location means "all locations"; plain UNIQUE treats NULLs as distinct.
  @@index([providerId, serviceId]) // runtime partial index: provider_services_providerwide_unique
  @@index([serviceId, isActive])
  @@map("provider_services")
}

model Medicine {
  id                   String           @id @map("_id") @default(uuid(7))
  name                 String
  genericName          String?          @map("generic_name")
  strength             String?
  dosageForm           String?          @map("dosage_form")
  packSize             String?          @map("pack_size")
  manufacturer         String?
  schedule             MedicineSchedule @default(OTC)
  requiresPrescription Boolean          @default(false) @map("requires_prescription")
  isActive             Boolean          @default(true) @map("is_active")
  /// CDCI brand identifier (Common Drug Codes for India). Unique when present (partial index in mongo-indexes.ts).
  code                 String?
  /// CDCI generic identifier.
  genericCode          String?          @map("generic_code")
  /// Active ingredients, e.g. "Paracetamol and Caffeine".
  composition          String?
  route                String?
  /// CDCI | MANUAL | PROVIDER
  source               String           @default("MANUAL")
  proposedByProviderId String?          @map("proposed_by_provider_id")
  proposedByUserId     String?          @map("proposed_by_user_id")
  /// Lower-case name + composition, used for prefix search.
  searchName           String?          @map("search_name")
  /// Normalised "same salt, same strength, same form" key (lower-case ingredients sorted, strength, dosage form).
  /// Medicines sharing a key are substitutes of each other. Recomputed whenever composition, strength or form changes.
  compositionKey       String?          @map("composition_key")

  // ── Patient-facing information. Filled from CDCI where available (GenericMaster / SubstanceMaster), editable by admins.
  /// Drug class, e.g. "Analgesic", "Antihistamine" (CDCI "Therapeutic Role").
  therapeuticClass     String?          @map("therapeutic_class")
  /// What it is used for (CDCI "Indication").
  uses                 String?
  /// How it works (CDCI substance description).
  howItWorks           String?          @map("how_it_works")
  /// Common side effects (CDCI substance toxicity / adverse reactions, or admin text).
  sideEffects          String?          @map("side_effects")
  /// When not to use it (CDCI "Contra Indication").
  contraindications    String?
  /// Medicines or foods it interacts with (CDCI "Interaction with Drugs").
  interactions         String?
  /// Safety advice: pregnancy, alcohol, driving, kidney or liver conditions (admin text).
  precautions          String?
  /// How to store it (admin text).
  storage              String?
  /// CDCI | ADMIN. ADMIN means an admin edited the information, so imports never overwrite it.
  infoSource           String?          @map("info_source")
  infoUpdatedAt        DateTime?        @map("info_updated_at")
  infoUpdatedById      String?          @map("info_updated_by_id")

  // ── Product photo (pack or strip). Stored with src/lib/storage.ts; served publicly by the API.
  imageKey             String?          @map("image_key")
  imageMimeType        String?          @map("image_mime_type")
  /// Content hash; also the cache-busting version in the public image URL.
  imageSha256          String?          @map("image_sha256")
  /// ADMIN | PROVIDER | WEB. A pharmacy may add a photo when none exists or replace its own or a WEB one; only admins replace an ADMIN photo.
  imageSource          String?          @map("image_source")
  /// For WEB photos (openly licensed, chosen by an admin): credit line, licence and the source page, shown wherever the photo is shown.
  imageCredit          String?          @map("image_credit")
  imageLicence         String?          @map("image_licence")
  imageSourceUrl       String?          @map("image_source_url")
  /// True when the photo shows the salt/generic, not this brand's pack ("Representative image").
  imageIsRepresentative Boolean         @default(false) @map("image_is_representative")
  imageUpdatedAt       DateTime?        @map("image_updated_at")
  imageUpdatedById     String?          @map("image_updated_by_id")
  imageUpdatedByProviderId String?      @map("image_updated_by_provider_id")

  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  inventory  PharmacyInventory[]
  orderItems PharmacyOrderItem[]

  @@unique([name, strength, dosageForm, packSize, manufacturer])
  @@index([name], map: "medicines_name_trgm_idx")
  @@index([genericName])
  @@index([searchName])
  @@index([source])
  @@index([compositionKey])
  @@map("medicines")
}
