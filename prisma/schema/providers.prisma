// ─── Healthcare providers ───────────────────────────────────────────────────
//
// Shared core (Provider) + type-specific detail tables. A doctor is a Provider of
// type DOCTOR with exactly one DoctorProfile tied to the doctor's own User; a
// hospital is a Provider of type HOSPITAL with a FacilityProfile. Doctors are
// never duplicated per hospital — see DoctorAffiliation in operations.prisma.

enum ProviderType {
  DOCTOR
  HOSPITAL
  CLINIC
  DIAGNOSTIC_LAB
  IMAGING_CENTRE
  PHARMACY
  AMBULANCE_OPERATOR
}

/// Lifecycle: DRAFT → SUBMITTED → UNDER_REVIEW → (CHANGES_REQUESTED ↔ UNDER_REVIEW)
/// → APPROVED | REJECTED; APPROVED ↔ SUSPENDED; any → DEACTIVATED.
/// Allowed transitions are enforced in src/modules/providers/provider-state.ts.
enum ProviderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum RegionStatus {
  PLANNED
  PILOT
  LIVE
  PAUSED
}

enum OwnershipType {
  PRIVATE
  GOVERNMENT
  TRUST_OR_NGO
  OTHER
}

enum ProviderMemberRole {
  OWNER
  ADMIN
  STAFF
  PHARMACIST
  LAB_TECHNICIAN
  DISPATCHER
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum DocumentType {
  MEDICAL_REGISTRATION_CERTIFICATE
  DEGREE_CERTIFICATE
  IDENTITY_PROOF
  GST_CERTIFICATE
  CLINICAL_ESTABLISHMENT_REGISTRATION
  TRADE_LICENSE
  DRUG_LICENSE
  PHARMACIST_REGISTRATION
  NABL_ACCREDITATION
  AERB_LICENSE
  PCPNDT_REGISTRATION
  FIRE_NOC
  BIOMEDICAL_WASTE_AUTHORISATION
  VEHICLE_REGISTRATION_CERTIFICATE
  VEHICLE_INSURANCE
  VEHICLE_FITNESS_CERTIFICATE
  VEHICLE_PERMIT
  DRIVING_LICENSE
  BANK_PROOF
  AGREEMENT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum VerificationCaseKind {
  ONBOARDING
  RENEWAL
  CHANGE_REQUEST
  COMPLAINT_TRIGGERED
  PERIODIC_REVIEW
}

enum VerificationCaseStatus {
  OPEN
  IN_REVIEW
  AWAITING_PROVIDER
  APPROVED
  REJECTED
  CANCELLED
}

enum VerificationCheckType {
  IDENTITY
  PROFESSIONAL_REGISTRATION
  QUALIFICATION
  FACILITY_REGISTRATION
  TAX_REGISTRATION
  DRUG_LICENSE
  RADIOLOGY_LICENSE
  ACCREDITATION
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  ADDRESS
  BANK_ACCOUNT
}

enum VerificationCheckStatus {
  PENDING
  PASSED
  FAILED
  WAIVED
}

/// How a check was performed. There is no single government API covering every
/// identifier; most checks start as documented manual reviews.
enum VerificationMethod {
  MANUAL_DOCUMENT_REVIEW
  OFFICIAL_REGISTRY_LOOKUP
  AUTHORISED_THIRD_PARTY_API
  ISSUER_CONFIRMATION
  PHYSICAL_INSPECTION
}

enum PayoutAccountStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISABLED
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ReviewStatus {
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  HIDDEN
}

/// Geographic rollout unit. Carevanta launches in Moyna and Tamluk (Purba
/// Medinipur, West Bengal) and expands region by region.
model ServiceRegion {
  id         String       @id @map("_id") @default(uuid(7))
  code       String       @unique
  name       String
  district   String
  state      String
  status     RegionStatus @default(PLANNED)
  launchedAt DateTime?    @map("launched_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  locations ProviderLocation[]

  @@map("service_regions")
}

model Provider {
  id                 String         @id @map("_id") @default(uuid(7))
  type               ProviderType
  status             ProviderStatus @default(DRAFT)
  legalName          String         @map("legal_name")
  displayName        String         @map("display_name")
  slug               String         @unique
  description        String?
  contactEmail       String?        @map("contact_email")
  contactPhone       String?        @map("contact_phone")
  gstin              String?
  registrationNumber String?        @map("registration_number")
  isListed           Boolean        @default(false) @map("is_listed")
  submittedAt        DateTime?      @map("submitted_at")
  approvedAt         DateTime?      @map("approved_at")
  approvedById       String?        @map("approved_by_id")
  suspendedAt        DateTime?      @map("suspended_at")
  statusReason       String?        @map("status_reason")
  ratingAverage      Float?       @map("rating_average")
  ratingCount        Int            @default(0) @map("rating_count")
  createdById        String?        @map("created_by_id")
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  doctorProfile     DoctorProfile?
  facilityProfile   FacilityProfile?
  diagnosticProfile DiagnosticProfile?
  pharmacyProfile   PharmacyProfile?
  ambulanceProfile  AmbulanceOperatorProfile?

  locations          ProviderLocation[]
  serviceAreas       ProviderServiceArea[]
  members            ProviderMember[]
  documents          ProviderDocument[]
  verificationCases  VerificationCase[]
  statusHistory      ProviderStatusHistory[]
  payoutAccounts     ProviderPayoutAccount[]
  agreements         ProviderAgreement[]
  reviews            Review[]
  departments        FacilityDepartment[]
  amenities          ProviderAmenity[]
  services           ProviderService[]
  doctorAffiliations   DoctorAffiliation[] @relation("AffiliationDoctor")
  facilityAffiliations DoctorAffiliation[] @relation("AffiliationFacility")
  doctorSlots          AppointmentSlot[]   @relation("SlotDoctor")
  doctorSchedules      DoctorSchedule[]    @relation("ScheduleDoctor")
  appointmentsAsDoctor   Appointment[]     @relation("AppointmentDoctor")
  appointmentsAsFacility Appointment[]     @relation("AppointmentFacility")
  diagnosticOrders   DiagnosticOrder[]
  pharmacyOrders     PharmacyOrder[]
  inventory          PharmacyInventory[]
  vehicles           AmbulanceVehicle[]
  crew               AmbulanceCrewMember[]
  dispatchAssignments DispatchAssignment[]
  transactions       ServiceTransaction[]
  commissionPolicies CommissionPolicy[]
  ledgerEntries      ProviderLedgerEntry[]
  settlementItems    SettlementItem[]
  supportCases       SupportCase[]

  @@index([type, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([displayName], map: "providers_display_name_trgm_idx")
  @@index([gstin])
  @@map("providers")
}

model DoctorProfile {
  providerId          String   @id @map("_id")
  userId              String   @unique @map("user_id")
  gender              String?
  yearsOfExperience   Int?     @map("years_of_experience")
  languages           String[] @default([])
  defaultFeeMinor     BigInt?  @map("default_fee_minor")
  currency            String   @default("INR")
  bio                 String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  provider       Provider                   @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  specialities   DoctorSpeciality[]
  qualifications DoctorQualification[]
  registrations  ProfessionalRegistration[]

  @@map("doctor_profiles")
}

model DoctorSpeciality {
  id String @id @default(uuid(7)) @map("_id")
  doctorProviderId String   @map("doctor_provider_id")
  specialityId     String   @map("speciality_id")
  isPrimary        Boolean  @default(false) @map("is_primary")
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  doctor     DoctorProfile @relation(fields: [doctorProviderId], references: [providerId], onDelete: Cascade, onUpdate: NoAction)
  speciality Speciality    @relation(fields: [specialityId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([doctorProviderId, specialityId])
  @@index([specialityId])
  @@map("doctor_specialities")
}

model DoctorQualification {
  id               String   @id @map("_id") @default(uuid(7))
  doctorProviderId String   @map("doctor_provider_id")
  degree           String
  institution      String
  yearAwarded      Int?     @map("year_awarded")
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorProviderId], references: [providerId], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctorProviderId])
  @@map("doctor_qualifications")
}

/// Registration with a medical council (e.g. West Bengal Medical Council, NMC
/// National Medical Register). `verifiedAt` is only set through a
/// VerificationCheck of type PROFESSIONAL_REGISTRATION.
model ProfessionalRegistration {
  id                 String    @id @map("_id") @default(uuid(7))
  doctorProviderId   String    @map("doctor_provider_id")
  council            String
  registrationNumber String    @map("registration_number")
  registrationYear   Int?      @map("registration_year")
  validUntil         DateTime? @map("valid_until")
  verifiedAt         DateTime? @map("verified_at")
  verifiedById       String?   @map("verified_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorProviderId], references: [providerId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([council, registrationNumber])
  @@index([doctorProviderId])
  @@map("professional_registrations")
}

/// Hospitals and clinics.
model FacilityProfile {
  providerId                    String        @id @map("_id")
  ownershipType                 OwnershipType @default(PRIVATE) @map("ownership_type")
  bedCount                      Int?          @map("bed_count")
  icuBedCount                   Int?          @map("icu_bed_count")
  hasEmergency                  Boolean       @default(false) @map("has_emergency")
  isOpen24x7                    Boolean       @default(false) @map("is_open_24x7")
  establishmentRegistrationNo   String?       @map("establishment_registration_no")
  establishmentRegistrationAuth String?       @map("establishment_registration_authority")
  accreditations                String[]      @default([])
  createdAt                     DateTime      @default(now()) @map("created_at")
  updatedAt                     DateTime      @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("facility_profiles")
}

/// Diagnostic laboratories and imaging centres.
model DiagnosticProfile {
  providerId                  String   @id @map("_id")
  offersPathology             Boolean  @default(false) @map("offers_pathology")
  offersImaging               Boolean  @default(false) @map("offers_imaging")
  homeCollectionAvailable     Boolean  @default(false) @map("home_collection_available")
  establishmentRegistrationNo String?  @map("establishment_registration_no")
  nablCertificateNo           String?  @map("nabl_certificate_no")
  nablScope                   String?  @map("nabl_scope")
  aerbLicenseNo               String?  @map("aerb_license_no")
  pcpndtRegistrationNo        String?  @map("pcpndt_registration_no")
  typicalTurnaroundHours      Int?     @map("typical_turnaround_hours")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("diagnostic_profiles")
}

model PharmacyProfile {
  providerId              String   @id @map("_id")
  retailDrugLicenseNo     String?  @map("retail_drug_license_no")
  wholesaleDrugLicenseNo  String?  @map("wholesale_drug_license_no")
  drugLicenseValidUntil   DateTime? @map("drug_license_valid_until")
  pharmacistName          String?  @map("pharmacist_name")
  pharmacistRegistrationNo String? @map("pharmacist_registration_no")
  homeDeliveryAvailable   Boolean  @default(false) @map("home_delivery_available")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("pharmacy_profiles")
}

model AmbulanceOperatorProfile {
  providerId    String   @id @map("_id")
  dispatchPhone String?  @map("dispatch_phone")
  isOpen24x7    Boolean  @default(false) @map("is_open_24x7")
  fleetSize     Int?     @map("fleet_size")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ambulance_operator_profiles")
}

/// Physical site (branch). Coordinates use numeric(9,6) — roughly 0.1 m
/// precision. Proximity search uses a bounding-box prefilter on
/// (latitude, longitude) followed by haversine distance; PostGIS can replace
/// this when multi-district search volume justifies it (see docs/architecture.md).
model ProviderLocation {
  id           String   @id @map("_id") @default(uuid(7))
  providerId   String   @map("provider_id")
  regionId     String?  @map("region_id")
  name         String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  locality     String?
  city         String
  district     String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  phone        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  provider       Provider                 @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  region         ServiceRegion?           @relation(fields: [regionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  operatingHours ProviderOperatingHours[]
  slots          AppointmentSlot[]
  schedules      DoctorSchedule[]
  appointments   Appointment[]
  affiliations   DoctorAffiliation[]
  services       ProviderService[]
  inventory      PharmacyInventory[]
  vehicles       AmbulanceVehicle[]
  diagnosticOrders DiagnosticOrder[] @relation("DiagnosticOrderLocation")

  @@index([providerId])
  @@index([regionId])
  @@index([district, pincode])
  @@index([latitude, longitude])
  @@map("provider_locations")
}

/// Weekly opening hours expressed as minutes from local midnight (IST).
model ProviderOperatingHours {
  id          String  @id @map("_id") @default(uuid(7))
  locationId  String  @map("location_id")
  dayOfWeek   Int     @map("day_of_week") // 0 = Sunday
  opensAtMin  Int     @map("opens_at_min")
  closesAtMin Int     @map("closes_at_min")
  isClosed    Boolean @default(false) @map("is_closed")

  location ProviderLocation @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([locationId, dayOfWeek, opensAtMin])
  @@map("provider_operating_hours")
}

/// Where a provider delivers services away from its premises (home sample
/// collection, medicine delivery, ambulance coverage).
model ProviderServiceArea {
  id         String   @id @map("_id") @default(uuid(7))
  providerId String   @map("provider_id")
  district   String
  pincode    String?
  purpose    String // HOME_COLLECTION | DELIVERY | AMBULANCE
  createdAt  DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([providerId, purpose, district, pincode])
  @@index([district, pincode, purpose])
  @@map("provider_service_areas")
}

/// A user's authority within a provider organisation. Provider-scoped
/// permissions are derived from memberRole; they never grant platform access.
model ProviderMember {
  id          String             @id @map("_id") @default(uuid(7))
  providerId  String             @map("provider_id")
  userId      String             @map("user_id")
  memberRole  ProviderMemberRole @map("member_role")
  status      MemberStatus       @default(INVITED)
  invitedById String?            @map("invited_by_id")
  joinedAt    DateTime?          @map("joined_at")
  removedAt   DateTime?          @map("removed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([providerId, userId])
  @@index([userId])
  @@map("provider_members")
}

/// Metadata for an uploaded document. The file itself lives in private object
/// storage under `storageKey`; it is never served from a public URL.
model ProviderDocument {
  id             String         @id @map("_id") @default(uuid(7))
  providerId     String         @map("provider_id")
  documentType   DocumentType   @map("document_type")
  status         DocumentStatus @default(UPLOADED)
  storageKey     String         @unique @map("storage_key")
  fileName       String         @map("file_name")
  mimeType       String         @map("mime_type")
  sizeBytes      Int            @map("size_bytes")
  sha256         String
  documentNumber String?        @map("document_number")
  issuedAt       DateTime?      @map("issued_at")
  expiresAt      DateTime?      @map("expires_at")
  uploadedById   String?        @map("uploaded_by_id")
  reviewedById   String?        @map("reviewed_by_id")
  reviewedAt     DateTime?      @map("reviewed_at")
  reviewNote     String?        @map("review_note")
  createdAt      DateTime       @default(now()) @map("created_at")

  provider Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  checks   VerificationCheck[]

  @@index([providerId, documentType])
  @@index([expiresAt])
  @@index([status, createdAt])
  @@map("provider_documents")
}

model VerificationCase {
  id           String                 @id @map("_id") @default(uuid(7))
  providerId   String                 @map("provider_id")
  kind         VerificationCaseKind   @default(ONBOARDING)
  status       VerificationCaseStatus @default(OPEN)
  assignedToId String?                @map("assigned_to_id")
  openedById   String?                @map("opened_by_id")
  decidedById  String?                @map("decided_by_id")
  decidedAt    DateTime?              @map("decided_at")
  decisionNote String?                @map("decision_note")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  provider Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  checks   VerificationCheck[]

  @@index([providerId]) // runtime partial index: verification_cases_one_open_per_provider
  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@map("verification_cases")
}

model VerificationCheck {
  id                 String                  @id @map("_id") @default(uuid(7))
  caseId             String                  @map("case_id")
  checkType          VerificationCheckType   @map("check_type")
  status             VerificationCheckStatus @default(PENDING)
  method             VerificationMethod      @default(MANUAL_DOCUMENT_REVIEW)
  isRequired         Boolean                 @default(true) @map("is_required")
  sourceReference    String?                 @map("source_reference")
  evidenceDocumentId String?                 @map("evidence_document_id")
  checkedById        String?                 @map("checked_by_id")
  checkedAt          DateTime?               @map("checked_at")
  notes              String?
  validUntil         DateTime?               @map("valid_until")
  createdAt          DateTime                @default(now()) @map("created_at")

  case     VerificationCase  @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evidence ProviderDocument? @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([caseId, checkType])
  @@map("verification_checks")
}

model ProviderStatusHistory {
  id          String          @id @map("_id") @default(uuid(7))
  providerId  String          @map("provider_id")
  fromStatus  ProviderStatus? @map("from_status")
  toStatus    ProviderStatus  @map("to_status")
  changedById String?         @map("changed_by_id")
  reason      String?
  createdAt   DateTime        @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([providerId, createdAt])
  @@map("provider_status_history")
}

/// Bank account for settlements. The full account number is encrypted with
/// AES-256-GCM (DATA_ENCRYPTION_KEY); only the last four digits are queryable.
model ProviderPayoutAccount {
  id                     String              @id @map("_id") @default(uuid(7))
  providerId             String              @map("provider_id")
  accountHolderName      String              @map("account_holder_name")
  accountNumberEncrypted String              @map("account_number_encrypted")
  accountNumberLast4     String              @map("account_number_last4")
  ifsc                   String
  status                 PayoutAccountStatus @default(PENDING_VERIFICATION)
  verifiedById           String?             @map("verified_by_id")
  verifiedAt             DateTime?           @map("verified_at")
  createdById            String?             @map("created_by_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  disabledAt             DateTime?           @map("disabled_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([providerId])
  @@map("provider_payout_accounts")
}

model ProviderAgreement {
  id              String          @id @map("_id") @default(uuid(7))
  providerId      String          @map("provider_id")
  agreementNumber String          @unique @map("agreement_number")
  status          AgreementStatus @default(DRAFT)
  effectiveFrom   DateTime        @map("effective_from")
  effectiveTo     DateTime?       @map("effective_to")
  signedAt        DateTime?       @map("signed_at")
  documentId      String?         @map("document_id")
  notes           String?
  createdById     String?         @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  provider Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  policies CommissionPolicy[]

  @@index([providerId, status])
  @@map("provider_agreements")
}

model Review {
  id            String       @id @map("_id") @default(uuid(7))
  providerId    String       @map("provider_id")
  authorUserId  String       @map("author_user_id")
  appointmentId String?      @unique @map("appointment_id")
  rating        Int
  comment       String?
  status        ReviewStatus @default(PENDING_MODERATION)
  moderatedById String?      @map("moderated_by_id")
  moderatedAt   DateTime?    @map("moderated_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([providerId, status, createdAt(sort: Desc)])
  @@map("reviews")
}
