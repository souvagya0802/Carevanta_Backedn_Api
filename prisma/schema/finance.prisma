// ─── Payments, commissions and settlements ──────────────────────────────────
//
// Carevanta's revenue is commission on eligible, completed transactions.
//
//   ServiceTransaction  one billable unit (an appointment, diagnostic order,
//                       pharmacy order or dispatch) — the anchor for money.
//   Payment / Refund    gateway money movements, confirmed only server-side.
//   CommissionSnapshot  immutable record of the policy + numbers used for one
//                       transaction. Changing a policy never rewrites history.
//   ProviderLedgerEntry append-only signed entries; payable balance = SUM.
//   SettlementBatch     maker-checker payout run; items need bank evidence (UTR).
//
// All amounts are BigInt minor units (paise) with an explicit currency.

enum TransactionSourceType {
  APPOINTMENT
  DIAGNOSTIC_ORDER
  PHARMACY_ORDER
  AMBULANCE_DISPATCH
}

enum TransactionStatus {
  PENDING_PAYMENT
  PAID
  PAY_AT_PROVIDER
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum CommissionCategory {
  CONSULTATION
  DIAGNOSTIC
  PHARMACY
  PROCEDURE
  SURGERY
  AMBULANCE
  OTHER
}

enum CommissionMethod {
  PERCENTAGE
  FLAT
}

enum PolicyStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  RETIRED
}

/// Indian legal review of the commercial arrangement. Policies may not be
/// activated in APP_ENV=production unless APPROVED (see finance/policy rules).
enum LegalReviewStatus {
  NOT_REVIEWED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  TEST_GATEWAY
  /// Money received outside any gateway (bank transfer, UPI to the platform account, cash deposit) and recorded by finance staff.
  MANUAL
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum CommissionSnapshotStatus {
  PROVISIONAL
  FINAL
  REVERSED
}

enum LedgerEntryType {
  SERVICE_EARNING
  COMMISSION
  COMMISSION_TAX
  REFUND_CLAWBACK
  COMMISSION_REVERSAL
  SETTLEMENT_PAYOUT
  SETTLEMENT_REVERSAL
  ADJUSTMENT
}

enum SettlementBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  CANCELLED
}

enum SettlementItemStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum ReconciliationStatus {
  MATCHED
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  MISSING_INTERNAL
  MISSING_AT_GATEWAY
  RESOLVED
}

model ServiceTransaction {
  id                 String                @id @map("_id") @default(uuid(7))
  reference          String                @unique
  sourceType         TransactionSourceType @map("source_type")
  appointmentId      String?               @unique @map("appointment_id")
  diagnosticOrderId  String?               @unique @map("diagnostic_order_id")
  pharmacyOrderId    String?               @unique @map("pharmacy_order_id")
  dispatchRequestId  String?               @unique @map("dispatch_request_id")
  providerId         String                @map("provider_id")
  patientProfileId   String?               @map("patient_profile_id")
  category           CommissionCategory
  grossMinor         BigInt                @map("gross_minor")
  refundedMinor      BigInt                @default(0) @map("refunded_minor")
  currency           String                @default("INR")
  status             TransactionStatus     @default(PENDING_PAYMENT)
  attribution        Attribution
  commissionEligible Boolean               @default(false) @map("commission_eligible")
  eligibilityReason  String?               @map("eligibility_reason")
  serviceCompletedAt DateTime?             @map("service_completed_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  /// Bumped inside money-moving transactions so concurrent writers conflict and serialise (replaces SELECT … FOR UPDATE).
  version            Int                   @default(1)

  appointment     Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  diagnosticOrder DiagnosticOrder?      @relation(fields: [diagnosticOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pharmacyOrder   PharmacyOrder?        @relation(fields: [pharmacyOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dispatchRequest DispatchRequest?      @relation(fields: [dispatchRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  provider        Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patient         PatientProfile?       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payments        Payment[]
  refunds         Refund[]
  commissions     CommissionSnapshot[]
  ledgerEntries   ProviderLedgerEntry[]
  supportCases    SupportCase[]

  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // Analytics and settlement windows filter on completion time alone.
  @@index([serviceCompletedAt]) // runtime partial index: service_transactions_completed_at_idx
  @@map("service_transactions")
}

/// Effective-dated, versioned commission rule. Scope resolution (most specific
/// wins): provider agreement → provider type + category → category default.
/// Overlapping ACTIVE policies for the same scope are rejected by an EXCLUDE
/// constraint (see migration SQL).
model CommissionPolicy {
  id                String             @id @map("_id") @default(uuid(7))
  code              String
  version           Int                @default(1)
  name              String
  description       String?
  category          CommissionCategory
  providerType      ProviderType?      @map("provider_type")
  providerId        String?            @map("provider_id")
  agreementId       String?            @map("agreement_id")
  /// "<category>|<providerType or *>|<providerId or *>" — maintained by a DB
  /// trigger; used by the no-overlap EXCLUDE constraint. Do not set manually.
  scopeKey          String             @default("") @map("scope_key")
  method            CommissionMethod
  rateBps           Int?               @map("rate_bps") // basis points: 1000 = 10.00%
  flatMinor         BigInt?            @map("flat_minor")
  minMinor          BigInt?            @map("min_minor")
  maxMinor          BigInt?            @map("max_minor")
  taxRateBps        Int                @default(0) @map("tax_rate_bps") // tax charged on commission (e.g. GST) — confirm with CA
  currency          String             @default("INR")
  status            PolicyStatus       @default(DRAFT)
  legalReviewStatus LegalReviewStatus  @default(NOT_REVIEWED) @map("legal_review_status")
  legalReviewNote   String?            @map("legal_review_note")
  legalReviewedById String?            @map("legal_reviewed_by_id")
  effectiveFrom     DateTime           @map("effective_from")
  effectiveTo       DateTime?          @map("effective_to")
  createdById       String?            @map("created_by_id")
  approvedById      String?            @map("approved_by_id")
  approvedAt        DateTime?          @map("approved_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  provider  Provider?            @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  agreement ProviderAgreement?   @relation(fields: [agreementId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  snapshots CommissionSnapshot[]

  @@unique([code, version])
  @@index([category, status, effectiveFrom])
  @@index([providerId, status])
  @@map("commission_policies")
}

model Payment {
  id                String         @id @map("_id") @default(uuid(7))
  transactionId     String         @map("transaction_id")
  gateway           PaymentGateway
  gatewayOrderId    String         @map("gateway_order_id")
  gatewayPaymentId  String?        @map("gateway_payment_id")
  amountMinor       BigInt         @map("amount_minor")
  refundedMinor     BigInt         @default(0) @map("refunded_minor")
  currency          String         @default("INR")
  status            PaymentStatus  @default(CREATED)
  method            String?
  failureCode       String?        @map("failure_code")
  failureReason     String?        @map("failure_reason")
  capturedAt        DateTime?      @map("captured_at")
  idempotencyKey    String?        @unique @map("idempotency_key")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refunds     Refund[]

  @@unique([gateway, gatewayOrderId])
  @@unique([gateway, gatewayPaymentId])
  @@index([transactionId])
  @@index([status, createdAt(sort: Desc)])
  @@map("payments")
}

/// Raw gateway webhook, stored once per (gateway, eventId) so duplicate
/// deliveries are acknowledged but not re-applied.
model PaymentWebhookEvent {
  id               String                  @id @map("_id") @default(uuid(7))
  gateway          PaymentGateway
  eventId          String                  @map("event_id")
  eventType        String                  @map("event_type")
  payloadSha256    String                  @map("payload_sha256")
  payload          Json
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingError  String?                 @map("processing_error")
  receivedAt       DateTime                @default(now()) @map("received_at")
  processedAt      DateTime?               @map("processed_at")
  /// Bumped inside the processing transaction so concurrent deliveries of the same event conflict and serialise.
  version          Int                     @default(1)

  @@unique([gateway, eventId])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id              String       @id @map("_id") @default(uuid(7))
  reference       String       @unique
  transactionId   String       @map("transaction_id")
  paymentId       String?      @map("payment_id")
  amountMinor     BigInt       @map("amount_minor")
  currency        String       @default("INR")
  reason          String
  status          RefundStatus @default(REQUESTED)
  requestedById   String?      @map("requested_by_id")
  reviewedById    String?      @map("reviewed_by_id")
  reviewedAt      DateTime?    @map("reviewed_at")
  reviewNote      String?      @map("review_note")
  gatewayRefundId String?      @unique @map("gateway_refund_id")
  processedAt     DateTime?    @map("processed_at")
  failureReason   String?      @map("failure_reason")
  idempotencyKey  String?      @unique @map("idempotency_key")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([transactionId])
  @@index([status, createdAt(sort: Desc)])
  @@map("refunds")
}

/// Immutable calculation record. A reversal creates a new REVERSED-status
/// marker on the old row plus compensating ledger entries; numbers never change.
model CommissionSnapshot {
  id              String                   @id @map("_id") @default(uuid(7))
  transactionId   String                   @map("transaction_id")
  policyId        String                   @map("policy_id")
  policyCode      String                   @map("policy_code")
  policyVersion   Int                      @map("policy_version")
  method          CommissionMethod
  rateBps         Int?                     @map("rate_bps")
  flatMinor       BigInt?                  @map("flat_minor")
  minMinor        BigInt?                  @map("min_minor")
  maxMinor        BigInt?                  @map("max_minor")
  taxRateBps      Int                      @map("tax_rate_bps")
  baseMinor       BigInt                   @map("base_minor")
  commissionMinor BigInt                   @map("commission_minor")
  taxMinor        BigInt                   @map("tax_minor")
  providerNetMinor BigInt                  @map("provider_net_minor")
  currency        String
  status          CommissionSnapshotStatus @default(FINAL)
  calculatedAt    DateTime                 @default(now()) @map("calculated_at")
  reversedAt      DateTime?                @map("reversed_at")
  reversalReason  String?                  @map("reversal_reason")

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  policy      CommissionPolicy   @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([transactionId]) // runtime partial index: commission_snapshots_one_live
  @@index([policyId])
  @@index([calculatedAt])
  @@map("commission_snapshots")
}

/// Append-only. `dedupeKey` makes every posting idempotent (e.g.
/// "earning:<txnId>", "commission:<snapshotId>").
model ProviderLedgerEntry {
  id               String          @id @map("_id") @default(uuid(7))
  providerId       String          @map("provider_id")
  transactionId    String?         @map("transaction_id")
  settlementItemId String?         @map("settlement_item_id")
  entryType        LedgerEntryType @map("entry_type")
  amountMinor      BigInt          @map("amount_minor") // signed: + owed to provider, − owed by provider
  currency         String          @default("INR")
  dedupeKey        String          @unique @map("dedupe_key")
  description      String?
  createdById      String?         @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  provider       Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transaction    ServiceTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  settlementItem SettlementItem?     @relation(fields: [settlementItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([providerId, createdAt])
  @@index([providerId]) // runtime partial index: ledger_unsettled_by_provider
  @@index([transactionId])
  @@map("provider_ledger_entries")
}

model SettlementBatch {
  id           String                @id @map("_id") @default(uuid(7))
  reference    String                @unique
  status       SettlementBatchStatus @default(DRAFT)
  periodEnd    DateTime              @map("period_end")
  currency     String                @default("INR")
  totalMinor   BigInt                @default(0) @map("total_minor")
  itemCount    Int                   @default(0) @map("item_count")
  createdById  String                @map("created_by_id")
  approvedById String?               @map("approved_by_id")
  approvedAt   DateTime?             @map("approved_at")
  completedAt  DateTime?             @map("completed_at")
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  items SettlementItem[]

  @@index([status, createdAt(sort: Desc)])
  @@map("settlement_batches")
}

model SettlementItem {
  id               String               @id @map("_id") @default(uuid(7))
  batchId          String               @map("batch_id")
  providerId       String               @map("provider_id")
  payoutAccountId  String?              @map("payout_account_id")
  amountMinor      BigInt               @map("amount_minor")
  currency         String               @default("INR")
  status           SettlementItemStatus @default(PENDING)
  payoutReference  String?              @unique @map("payout_reference") // bank UTR
  paidAt           DateTime?            @map("paid_at")
  evidenceNote     String?              @map("evidence_note")
  failureReason    String?              @map("failure_reason")
  attemptCount     Int                  @default(0) @map("attempt_count")
  recordedById     String?              @map("recorded_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  batch         SettlementBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  provider      Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ledgerEntries ProviderLedgerEntry[]

  @@unique([batchId, providerId])
  @@index([providerId, status])
  @@map("settlement_items")
}

model ReconciliationRecord {
  id               String               @id @map("_id") @default(uuid(7))
  runId            String               @map("run_id")
  gateway          PaymentGateway
  gatewayReference String?              @map("gateway_reference")
  paymentId        String?              @map("payment_id")
  expectedMinor    BigInt?              @map("expected_minor")
  actualMinor      BigInt?              @map("actual_minor")
  expectedStatus   String?              @map("expected_status")
  actualStatus     String?              @map("actual_status")
  status           ReconciliationStatus
  resolvedById     String?              @map("resolved_by_id")
  resolvedAt       DateTime?            @map("resolved_at")
  resolutionNote   String?              @map("resolution_note")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([runId])
  @@index([status, createdAt(sort: Desc)])
  @@map("reconciliation_records")
}

/// Generic HTTP idempotency store for retryable POSTs (bookings, refunds,
/// settlements). Scoped per user + route so keys cannot collide across users.
model IdempotencyRecord {
  id             String    @id @map("_id") @default(uuid(7))
  userId         String    @map("user_id")
  scope          String
  key            String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
