// ─── Payments, commissions and settlements ──────────────────────────────────
//
// Carevanta's revenue is commission on eligible, completed transactions.
//
//   ServiceTransaction  one billable unit (an appointment, diagnostic order,
//                       pharmacy order or dispatch) — the anchor for money.
//   Payment / Refund    gateway money movements, confirmed only server-side.
//   CommissionSnapshot  immutable record of the policy + numbers used for one
//                       transaction. Changing a policy never rewrites history.
//   ProviderLedgerEntry append-only signed entries; payable balance = SUM.
//   SettlementBatch     maker-checker payout run; items need bank evidence (UTR).
//
// All amounts are BigInt minor units (paise) with an explicit currency.

enum TransactionSourceType {
  APPOINTMENT
  DIAGNOSTIC_ORDER
  PHARMACY_ORDER
  AMBULANCE_DISPATCH
}

enum TransactionStatus {
  PENDING_PAYMENT
  PAID
  PAY_AT_PROVIDER
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum CommissionCategory {
  CONSULTATION
  DIAGNOSTIC
  PHARMACY
  PROCEDURE
  SURGERY
  AMBULANCE
  OTHER
}

enum CommissionMethod {
  PERCENTAGE
  FLAT
}

enum PolicyStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  RETIRED
}

/// Indian legal review of the commercial arrangement. Policies may not be
/// activated in APP_ENV=production unless APPROVED (see finance/policy rules).
enum LegalReviewStatus {
  NOT_REVIEWED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentGateway {
  RAZORPAY
  TEST_GATEWAY
  /// Money received outside any gateway (bank transfer, UPI to the platform account, cash deposit) and recorded by finance staff.
  MANUAL
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum CommissionSnapshotStatus {
  PROVISIONAL
  FINAL
  REVERSED
}

enum LedgerEntryType {
  SERVICE_EARNING
  COMMISSION
  COMMISSION_TAX
  REFUND_CLAWBACK
  COMMISSION_REVERSAL
  SETTLEMENT_PAYOUT
  SETTLEMENT_REVERSAL
  ADJUSTMENT
}

enum SettlementBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  CANCELLED
}

enum SettlementItemStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum ReconciliationStatus {
  MATCHED
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  MISSING_INTERNAL
  MISSING_AT_GATEWAY
  RESOLVED
}

model ServiceTransaction {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference          String                @unique @db.VarChar(24)
  sourceType         TransactionSourceType @map("source_type")
  appointmentId      String?               @unique @map("appointment_id") @db.Uuid
  diagnosticOrderId  String?               @unique @map("diagnostic_order_id") @db.Uuid
  pharmacyOrderId    String?               @unique @map("pharmacy_order_id") @db.Uuid
  dispatchRequestId  String?               @unique @map("dispatch_request_id") @db.Uuid
  providerId         String                @map("provider_id") @db.Uuid
  patientProfileId   String?               @map("patient_profile_id") @db.Uuid
  category           CommissionCategory
  grossMinor         BigInt                @map("gross_minor")
  refundedMinor      BigInt                @default(0) @map("refunded_minor")
  currency           String                @default("INR") @db.Char(3)
  status             TransactionStatus     @default(PENDING_PAYMENT)
  attribution        Attribution
  commissionEligible Boolean               @default(false) @map("commission_eligible")
  eligibilityReason  String?               @map("eligibility_reason") @db.VarChar(200)
  serviceCompletedAt DateTime?             @map("service_completed_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment     Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  diagnosticOrder DiagnosticOrder?      @relation(fields: [diagnosticOrderId], references: [id], onDelete: Restrict)
  pharmacyOrder   PharmacyOrder?        @relation(fields: [pharmacyOrderId], references: [id], onDelete: Restrict)
  dispatchRequest DispatchRequest?      @relation(fields: [dispatchRequestId], references: [id], onDelete: Restrict)
  provider        Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  patient         PatientProfile?       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  payments        Payment[]
  refunds         Refund[]
  commissions     CommissionSnapshot[]
  ledgerEntries   ProviderLedgerEntry[]
  supportCases    SupportCase[]

  @@index([providerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // Analytics and settlement windows filter on completion time alone.
  @@index([serviceCompletedAt], where: raw("service_completed_at IS NOT NULL"), map: "service_transactions_completed_at_idx")
  @@map("service_transactions")
}

/// Effective-dated, versioned commission rule. Scope resolution (most specific
/// wins): provider agreement → provider type + category → category default.
/// Overlapping ACTIVE policies for the same scope are rejected by an EXCLUDE
/// constraint (see migration SQL).
model CommissionPolicy {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code              String             @db.VarChar(64)
  version           Int                @default(1)
  name              String             @db.VarChar(160)
  description       String?            @db.VarChar(2000)
  category          CommissionCategory
  providerType      ProviderType?      @map("provider_type")
  providerId        String?            @map("provider_id") @db.Uuid
  agreementId       String?            @map("agreement_id") @db.Uuid
  /// "<category>|<providerType or *>|<providerId or *>" — maintained by a DB
  /// trigger; used by the no-overlap EXCLUDE constraint. Do not set manually.
  scopeKey          String             @default("") @map("scope_key") @db.VarChar(120)
  method            CommissionMethod
  rateBps           Int?               @map("rate_bps") // basis points: 1000 = 10.00%
  flatMinor         BigInt?            @map("flat_minor")
  minMinor          BigInt?            @map("min_minor")
  maxMinor          BigInt?            @map("max_minor")
  taxRateBps        Int                @default(0) @map("tax_rate_bps") // tax charged on commission (e.g. GST) — confirm with CA
  currency          String             @default("INR") @db.Char(3)
  status            PolicyStatus       @default(DRAFT)
  legalReviewStatus LegalReviewStatus  @default(NOT_REVIEWED) @map("legal_review_status")
  legalReviewNote   String?            @map("legal_review_note") @db.VarChar(2000)
  legalReviewedById String?            @map("legal_reviewed_by_id") @db.Uuid
  effectiveFrom     DateTime           @map("effective_from") @db.Timestamptz(3)
  effectiveTo       DateTime?          @map("effective_to") @db.Timestamptz(3)
  createdById       String?            @map("created_by_id") @db.Uuid
  approvedById      String?            @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?          @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider  Provider?            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  agreement ProviderAgreement?   @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  snapshots CommissionSnapshot[]

  @@unique([code, version])
  @@index([category, status, effectiveFrom])
  @@index([providerId, status])
  @@map("commission_policies")
}

model Payment {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  transactionId     String         @map("transaction_id") @db.Uuid
  gateway           PaymentGateway
  gatewayOrderId    String         @map("gateway_order_id") @db.VarChar(64)
  gatewayPaymentId  String?        @map("gateway_payment_id") @db.VarChar(64)
  amountMinor       BigInt         @map("amount_minor")
  refundedMinor     BigInt         @default(0) @map("refunded_minor")
  currency          String         @default("INR") @db.Char(3)
  status            PaymentStatus  @default(CREATED)
  method            String?        @db.VarChar(32)
  failureCode       String?        @map("failure_code") @db.VarChar(64)
  failureReason     String?        @map("failure_reason") @db.VarChar(500)
  capturedAt        DateTime?      @map("captured_at") @db.Timestamptz(3)
  idempotencyKey    String?        @unique @map("idempotency_key") @db.VarChar(80)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  refunds     Refund[]

  @@unique([gateway, gatewayOrderId])
  @@unique([gateway, gatewayPaymentId])
  @@index([transactionId])
  @@index([status, createdAt(sort: Desc)])
  @@map("payments")
}

/// Raw gateway webhook, stored once per (gateway, eventId) so duplicate
/// deliveries are acknowledged but not re-applied.
model PaymentWebhookEvent {
  id               String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  gateway          PaymentGateway
  eventId          String                  @map("event_id") @db.VarChar(100)
  eventType        String                  @map("event_type") @db.VarChar(64)
  payloadSha256    String                  @map("payload_sha256") @db.Char(64)
  payload          Json
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingError  String?                 @map("processing_error") @db.VarChar(1000)
  receivedAt       DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(3)

  @@unique([gateway, eventId])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference       String       @unique @db.VarChar(24)
  transactionId   String       @map("transaction_id") @db.Uuid
  paymentId       String?      @map("payment_id") @db.Uuid
  amountMinor     BigInt       @map("amount_minor")
  currency        String       @default("INR") @db.Char(3)
  reason          String       @db.VarChar(500)
  status          RefundStatus @default(REQUESTED)
  requestedById   String?      @map("requested_by_id") @db.Uuid
  reviewedById    String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String?      @map("review_note") @db.VarChar(1000)
  gatewayRefundId String?      @unique @map("gateway_refund_id") @db.VarChar(64)
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(3)
  failureReason   String?      @map("failure_reason") @db.VarChar(500)
  idempotencyKey  String?      @unique @map("idempotency_key") @db.VarChar(80)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([status, createdAt(sort: Desc)])
  @@map("refunds")
}

/// Immutable calculation record. A reversal creates a new REVERSED-status
/// marker on the old row plus compensating ledger entries; numbers never change.
model CommissionSnapshot {
  id              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  transactionId   String                   @map("transaction_id") @db.Uuid
  policyId        String                   @map("policy_id") @db.Uuid
  policyCode      String                   @map("policy_code") @db.VarChar(64)
  policyVersion   Int                      @map("policy_version")
  method          CommissionMethod
  rateBps         Int?                     @map("rate_bps")
  flatMinor       BigInt?                  @map("flat_minor")
  minMinor        BigInt?                  @map("min_minor")
  maxMinor        BigInt?                  @map("max_minor")
  taxRateBps      Int                      @map("tax_rate_bps")
  baseMinor       BigInt                   @map("base_minor")
  commissionMinor BigInt                   @map("commission_minor")
  taxMinor        BigInt                   @map("tax_minor")
  providerNetMinor BigInt                  @map("provider_net_minor")
  currency        String                   @db.Char(3)
  status          CommissionSnapshotStatus @default(FINAL)
  calculatedAt    DateTime                 @default(now()) @map("calculated_at") @db.Timestamptz(3)
  reversedAt      DateTime?                @map("reversed_at") @db.Timestamptz(3)
  reversalReason  String?                  @map("reversal_reason") @db.VarChar(500)

  transaction ServiceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  policy      CommissionPolicy   @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([transactionId], where: raw("status <> 'REVERSED'"), map: "commission_snapshots_one_live")
  @@index([policyId])
  @@index([calculatedAt])
  @@map("commission_snapshots")
}

/// Append-only. `dedupeKey` makes every posting idempotent (e.g.
/// "earning:<txnId>", "commission:<snapshotId>").
model ProviderLedgerEntry {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId       String          @map("provider_id") @db.Uuid
  transactionId    String?         @map("transaction_id") @db.Uuid
  settlementItemId String?         @map("settlement_item_id") @db.Uuid
  entryType        LedgerEntryType @map("entry_type")
  amountMinor      BigInt          @map("amount_minor") // signed: + owed to provider, − owed by provider
  currency         String          @default("INR") @db.Char(3)
  dedupeKey        String          @unique @map("dedupe_key") @db.VarChar(120)
  description      String?         @db.VarChar(300)
  createdById      String?         @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  provider       Provider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  transaction    ServiceTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  settlementItem SettlementItem?     @relation(fields: [settlementItemId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@index([providerId], where: raw("settlement_item_id IS NULL"), map: "ledger_unsettled_by_provider")
  @@index([transactionId])
  @@map("provider_ledger_entries")
}

model SettlementBatch {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reference    String                @unique @db.VarChar(24)
  status       SettlementBatchStatus @default(DRAFT)
  periodEnd    DateTime              @map("period_end") @db.Timestamptz(3)
  currency     String                @default("INR") @db.Char(3)
  totalMinor   BigInt                @default(0) @map("total_minor")
  itemCount    Int                   @default(0) @map("item_count")
  createdById  String                @map("created_by_id") @db.Uuid
  approvedById String?               @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?             @map("approved_at") @db.Timestamptz(3)
  completedAt  DateTime?             @map("completed_at") @db.Timestamptz(3)
  notes        String?               @db.VarChar(1000)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  items SettlementItem[]

  @@index([status, createdAt(sort: Desc)])
  @@map("settlement_batches")
}

model SettlementItem {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  batchId          String               @map("batch_id") @db.Uuid
  providerId       String               @map("provider_id") @db.Uuid
  payoutAccountId  String?              @map("payout_account_id") @db.Uuid
  amountMinor      BigInt               @map("amount_minor")
  currency         String               @default("INR") @db.Char(3)
  status           SettlementItemStatus @default(PENDING)
  payoutReference  String?              @unique @map("payout_reference") @db.VarChar(64) // bank UTR
  paidAt           DateTime?            @map("paid_at") @db.Timestamptz(3)
  evidenceNote     String?              @map("evidence_note") @db.VarChar(1000)
  failureReason    String?              @map("failure_reason") @db.VarChar(500)
  attemptCount     Int                  @default(0) @map("attempt_count")
  recordedById     String?              @map("recorded_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch         SettlementBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  provider      Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  ledgerEntries ProviderLedgerEntry[]

  @@unique([batchId, providerId])
  @@index([providerId, status])
  @@map("settlement_items")
}

model ReconciliationRecord {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  runId            String               @map("run_id") @db.Uuid
  gateway          PaymentGateway
  gatewayReference String?              @map("gateway_reference") @db.VarChar(64)
  paymentId        String?              @map("payment_id") @db.Uuid
  expectedMinor    BigInt?              @map("expected_minor")
  actualMinor      BigInt?              @map("actual_minor")
  expectedStatus   String?              @map("expected_status") @db.VarChar(32)
  actualStatus     String?              @map("actual_status") @db.VarChar(32)
  status           ReconciliationStatus
  resolvedById     String?              @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolutionNote   String?              @map("resolution_note") @db.VarChar(1000)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([runId])
  @@index([status, createdAt(sort: Desc)])
  @@map("reconciliation_records")
}

/// Generic HTTP idempotency store for retryable POSTs (bookings, refunds,
/// settlements). Scoped per user + route so keys cannot collide across users.
model IdempotencyRecord {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  scope          String    @db.VarChar(120)
  key            String    @db.VarChar(80)
  requestHash    String    @map("request_hash") @db.Char(64)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
