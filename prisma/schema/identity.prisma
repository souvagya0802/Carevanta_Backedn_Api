// ─── Identity, authentication and access control ───────────────────────────
//
// A User is a login identity. Being a patient, a doctor, a provider staff member
// or a platform administrator are *capabilities* attached to that identity:
//   - platform roles      → UserRole (RBAC, permission-based)
//   - provider authority  → ProviderMember (scoped to one provider)
//   - patient profiles    → PatientProfile (account holder + dependants)
// Authentication (who you are), authorisation (what you may do), account status
// (whether you may log in) and provider verification (whether a provider may
// operate) are deliberately separate concepts.

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ANONYMISED
}

enum RoleScope {
  PLATFORM
  PROVIDER
  PATIENT
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

model User {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email              String?    @unique @db.Citext
  phone              String?    @unique @db.VarChar(16) // E.164, e.g. +919800000000
  fullName           String     @map("full_name") @db.VarChar(160)
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  status             UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt    DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  preferredLanguage  String     @default("en") @map("preferred_language") @db.VarChar(8)
  statusReason       String?    @map("status_reason") @db.VarChar(500)
  anonymisedAt       DateTime?  @map("anonymised_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById        String?    @map("created_by_id") @db.Uuid

  roles             UserRole[]          @relation("UserRoles")
  rolesGranted      UserRole[]          @relation("RoleGrantedBy")
  rolesRevoked      UserRole[]          @relation("RoleRevokedBy")
  sessions          Session[]
  tokens            VerificationToken[]
  providerMemberships ProviderMember[]  @relation("MemberUser")
  patientProfiles   PatientProfile[]    @relation("PatientAccountHolder")
  doctorProfile     DoctorProfile?

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_full_name_trgm_idx")
  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String    @unique @db.VarChar(64)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  scope       RoleScope @default(PLATFORM)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String  @unique @db.VarChar(96) // e.g. "providers.approve"
  description String  @db.VarChar(300)
  isSensitive Boolean @default(false) @map("is_sensitive")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Platform role assignment. Revocation is recorded, never deleted, so the
/// history of who held which privilege is preserved for audit.
model UserRole {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid
  reason      String?   @db.VarChar(500)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("RoleRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId], where: raw("revoked_at IS NULL"), map: "user_roles_active_unique")
  @@index([roleId])
  @@map("user_roles")
}

/// Refresh-token session. Only a SHA-256 hash of the opaque refresh token is
/// stored. Rotation keeps the same familyId; presenting an already-rotated
/// token revokes the whole family (refresh-token reuse detection).
model Session {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  userAgent        String?   @map("user_agent") @db.VarChar(300)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  identifierHash String   @map("identifier_hash") @db.Char(64)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  success        Boolean
  reason         String   @db.VarChar(48)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifierHash, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("login_attempts")
}

model VerificationToken {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}
