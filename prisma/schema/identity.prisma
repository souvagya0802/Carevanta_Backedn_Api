// ─── Identity, authentication and access control ───────────────────────────
//
// A User is a login identity. Being a patient, a doctor, a provider staff member
// or a platform administrator are *capabilities* attached to that identity:
//   - platform roles      → UserRole (RBAC, permission-based)
//   - provider authority  → ProviderMember (scoped to one provider)
//   - patient profiles    → PatientProfile (account holder + dependants)
// Authentication (who you are), authorisation (what you may do), account status
// (whether you may log in) and provider verification (whether a provider may
// operate) are deliberately separate concepts.

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ANONYMISED
}

enum RoleScope {
  PLATFORM
  PROVIDER
  PATIENT
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

model User {
  id                 String     @id @map("_id") @default(uuid(7))
  email              String?    @unique
  phone              String?    @unique // E.164, e.g. +919800000000
  fullName           String     @map("full_name")
  passwordHash       String?    @map("password_hash")
  status             UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  phoneVerifiedAt    DateTime?  @map("phone_verified_at")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  preferredLanguage  String     @default("en") @map("preferred_language")
  statusReason       String?    @map("status_reason")
  anonymisedAt       DateTime?  @map("anonymised_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  createdById        String?    @map("created_by_id")

  roles             UserRole[]          @relation("UserRoles")
  rolesGranted      UserRole[]          @relation("RoleGrantedBy")
  rolesRevoked      UserRole[]          @relation("RoleRevokedBy")
  sessions          Session[]
  tokens            VerificationToken[]
  pushSubscriptions PushSubscription[]
  providerMemberships ProviderMember[]  @relation("MemberUser")
  patientProfiles   PatientProfile[]    @relation("PatientAccountHolder")
  doctorProfile     DoctorProfile?

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([fullName], map: "users_full_name_trgm_idx")
  @@map("users")
}

model Role {
  id          String    @id @map("_id") @default(uuid(7))
  key         String    @unique
  name        String
  description String?
  scope       RoleScope @default(PLATFORM)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @map("_id") @default(uuid(7))
  key         String  @unique // e.g. "providers.approve"
  description String
  isSensitive Boolean @default(false) @map("is_sensitive")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid(7)) @map("_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Platform role assignment. Revocation is recorded, never deleted, so the
/// history of who held which privilege is preserved for audit.
model UserRole {
  id          String    @id @map("_id") @default(uuid(7))
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id")
  reason      String?

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  revokedBy User? @relation("RoleRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, roleId]) // runtime partial index: user_roles_active_unique
  @@index([roleId])
  @@map("user_roles")
}

/// Refresh-token session. Only a SHA-256 hash of the opaque refresh token is
/// stored. Rotation keeps the same familyId; presenting an already-rotated
/// token revokes the whole family (refresh-token reuse detection).
model Session {
  id               String    @id @map("_id") @default(uuid(7))
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  rotatedAt        DateTime? @map("rotated_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id             String   @id @map("_id") @default(uuid(7))
  userId         String?  @map("user_id")
  identifierHash String   @map("identifier_hash")
  ipAddress      String?  @map("ip_address")
  success        Boolean
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([identifierHash, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("login_attempts")
}

model VerificationToken {
  id         String       @id @map("_id") @default(uuid(7))
  userId     String       @map("user_id")
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash")
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, purpose])
  @@map("verification_tokens")
}
