{
  "name": "carevanta-api",
  "version": "0.1.0",
  "private": true,
  "description": "Carevanta healthcare marketplace — backend API (modular monolith)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate && node scripts/generate-index-manifest.mjs",
    "db:sync": "tsx scripts/sync-indexes.ts",
    "db:backfill-nulls": "tsx scripts/backfill-nulls.ts",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "medicines:import": "tsx scripts/import-cdci.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:seed:more": "tsx scripts/demo-seed-more-types.ts",
    "demo:accounts": "tsx scripts/demo-accounts.ts",
    "demo:approve-search": "tsx scripts/demo-approve-mappings.ts",
    "demo:smoke": "tsx scripts/demo-smoke.ts",
    "demo:seed:volume": "tsx scripts/demo-seed-volume.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "postinstall": "prisma generate && node scripts/generate-index-manifest.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "country-state-city": "^3.2.1",
    "croner": "^9.1.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "mongodb": "^6.22.0",
    "nodemailer": "7.0.13",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "web-push": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/autocannon": "7.12.7",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ioredis-mock": "8.2.8",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/web-push": "^3.6.4",
    "autocannon": "8.0.0",
    "eslint": "9.39.5",
    "ioredis-mock": "8.13.1",
    "mongodb-memory-server": "^10.4.1",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
