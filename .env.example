# ─── Carevanta API — environment reference ───────────────────────────────────
# Copy to .env for local development. NEVER commit .env. Placeholders only here.

APP_ENV=development                 # development | test | staging | production
PORT=4000
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent
TRUST_PROXY=0                       # hops of trusted reverse proxies (1 behind one LB)

# MongoDB Atlas replica set (transactions require a replica set or mongos). Keep the real URI in .env only;
# never commit it, log it, or put it in frontend code. If the URI has no database name, MONGODB_DB is used.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=carevanta-api
MONGODB_DB=carevanta
DB_STATEMENT_TIMEOUT_MS=15000       # upper bound for one transaction

# Place search and reverse geocoding (map pickers, "use my location", PIN → point). The API proxies a free
# geocoder so browsers never call it directly and no key reaches a frontend.
#   nominatim  — OpenStreetMap's public service: no key, max 1 request/second (the API serialises calls),
#                and its usage policy requires a contact e-mail in the User-Agent.
#   locationiq — free tier 5,000 requests/day, Nominatim-compatible; needs GEOCODER_API_KEY.
GEOCODER_PROVIDER=nominatim         # nominatim | locationiq
GEOCODER_API_KEY=                   # LocationIQ key (leave empty for nominatim); never commit a real key
GEOCODER_CONTACT_EMAIL=ops@example.com   # sent as User-Agent "Carevanta/0.1 (+email)"

# Auth. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_min_32_chars_random
JWT_ISSUER=carevanta-api
JWT_AUDIENCE=carevanta
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# AES-256-GCM key for encrypted fields (bank accounts, notification payloads).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_32_bytes_base64

# Browser origins allowed to call the API (comma-separated). Required in production.
CORS_ORIGINS=http://localhost:3000

# Razorpay (optional in dev — a simulated gateway is used when unset; required in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Document / report storage (local driver for dev and single-node pilots)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_BYTES=10485760

JOBS_ENABLED=true                   # false → exports run inline, no worker expected
RATE_LIMIT_ENABLED=true             # only false for single-IP load tests; production refuses false
OPENAPI_ENABLED=true                # serves /docs and /api/v1/openapi.json
