# ─── Carevanta API — environment reference ───────────────────────────────────
# Copy to .env for local development. NEVER commit .env. Placeholders only here.

APP_ENV=development                 # development | test | staging | production
PORT=4000
LOG_LEVEL=info                      # fatal|error|warn|info|debug|trace|silent
TRUST_PROXY=0                       # hops of trusted reverse proxies (1 behind one LB)

# PostgreSQL (Neon). Runtime uses the POOLED host (…-pooler…); migrations and
# the worker use the DIRECT host. Prefer sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
DB_POOL_MAX=10                      # per API instance; instances × DB_POOL_MAX < pooler limit
DB_STATEMENT_TIMEOUT_MS=15000

# Auth. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_min_32_chars_random
JWT_ISSUER=carevanta-api
JWT_AUDIENCE=carevanta
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# AES-256-GCM key for encrypted fields (bank accounts, notification payloads).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME_32_bytes_base64

# Browser origins allowed to call the API (comma-separated). Required in production.
CORS_ORIGINS=http://localhost:3000

# Razorpay (optional in dev — a simulated gateway is used when unset; required in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Document / report storage (local driver for dev and single-node pilots)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_BYTES=10485760

JOBS_ENABLED=true                   # false → exports run inline, no worker expected
RATE_LIMIT_ENABLED=true             # only false for single-IP load tests; production refuses false
OPENAPI_ENABLED=true                # serves /docs and /api/v1/openapi.json
